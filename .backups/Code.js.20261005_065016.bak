/* [71] */ function aimLoad() {
  const aimsSheet = getAimsSheet();
  const entriesSheet = getAimEntriesSheet();
  const cdSheet = getCountdownsSheet();

  const cdByTitle = {};
  try {
    const cdData = cdSheet.getDataRange().getValues();
    for (let i = 1; i < cdData.length; i++) {
      if (!cdData[i][2]) continue;
      cdByTitle[String(cdData[i][2]).trim()] = cdData[i][3];
    }
  } catch (_) {}

  const aData = aimsSheet.getDataRange().getValues();
  const aims = [];
  for (let i = 1; i < aData.length; i++) {
    if (!aData[i][0]) continue;
    const title = aData[i][2] || '';
    const cdDeadline = cdByTitle[String(title).trim()];
    aims.push({
      id: aData[i][0],
      emoji: aData[i][1] || '🎯',
      title: title,
      notes: aData[i][3] || '',
      startDate: normalizeDateForOutput(aData[i][4]),
      deadline: cdDeadline ? normalizeDateForOutput(cdDeadline) : ''
    });
  }

  const eData = entriesSheet.getDataRange().getValues();
  const entries = {};
  aims.forEach(function (a) { entries[a.id] = []; });
  for (let i = 1; i < eData.length; i++) {
    if (!eData[i][0]) continue;
    const aimId = eData[i][1];
    if (!entries[aimId]) entries[aimId] = [];
    entries[aimId].push({
      id: eData[i][0],
      aimId: aimId,
      date: eData[i][2] || '',
      type: eData[i][3] || 'step',
      text: eData[i][4] || ''
    });
  }
  return { status: 'success', aims: aims, entries: entries };
}

/* [72] */ function aimSave(data) {
  const sheet = getAimsSheet();
  const now = new Date().toISOString();

  if (data.id) {
    const values = sheet.getDataRange().getValues();
    for (let i = 1; i < values.length; i++) {
      if (String(values[i][0]) === String(data.id)) {
        sheet.getRange(i+1, 2).setValue(data.emoji || '');
        sheet.getRange(i+1, 3).setValue(data.title || '');
        sheet.getRange(i+1, 4).setValue(data.notes || '');
        sheet.getRange(i+1, 5).setValue(data.startDate || '');
        if (data.deadline) updateLinkedCountdown(data.id, data.title, data.deadline);
        return { status: 'success' };
      }
    }
    return { status: 'error', message: 'aim not found' };
  }

  const id = 'a' + Date.now() + Math.random().toString(36).slice(2,5);
  sheet.appendRow([id, data.emoji || '', data.title || '', data.notes || '', data.startDate || '', now]);

  if (data.deadline && data.title) {
    try {
      const cdSheet = getCountdownsSheet();
      const cdId = 'c' + Date.now() + Math.random().toString(36).slice(2,5);
      cdSheet.appendRow([cdId, '🎯', data.title, data.deadline, 'Auto from aim: ' + data.title, '', now, now]);
    } catch (e) {
      Logger.log('Failed to create countdown for aim: ' + e);
    }
  }

  return { status: 'success', id: id };
}

/* [73] */ function aimDelete(id) {
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getAimsSheet();
  const data = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][0]) === String(id)) { sheet.deleteRow(i+1); break; }
  }
  const eSheet = getAimEntriesSheet();
  const eData = eSheet.getDataRange().getValues();
  for (let i = eData.length - 1; i >= 1; i--) {
    if (String(eData[i][1]) === String(id)) eSheet.deleteRow(i+1);
  }
  return { status: 'success' };
}

/* [74] */ function aimEntryAdd(data) {
  const aimId = data.aimId;
  const dateStr = data.date;
  const type = data.type || 'step';
  const text = String(data.text || '').trim();
  if (!aimId || !dateStr || !text) return { status: 'error', message: 'missing fields' };

  const aSheet = getAimsSheet();
  const aData = aSheet.getDataRange().getValues();
  let startDMY = null;
  for (let i = 1; i < aData.length; i++) {
    if (String(aData[i][0]) === String(aimId)) { startDMY = aData[i][4]; break; }
  }
  if (!startDMY) return { status: 'error', message: 'aim not found' };

  const start = parseDMY(startDMY);
  const entry = parseDMY(dateStr);
  if (!start || !entry) return { status: 'error', message: 'bad date' };
  const startDate = new Date(start[0], start[1], start[2]);
  const entryDate = new Date(entry[0], entry[1], entry[2]);
  if (entryDate < startDate) {
    return { status: 'error', message: 'Cannot log before aim start (' + startDMY + ')' };
  }

  const sheet = getAimEntriesSheet();
  const id = 'e' + Date.now() + Math.random().toString(36).slice(2,5);
  sheet.appendRow([id, aimId, dateStr, type, text, new Date().toISOString()]);
  return { status: 'success', id: id };
}

/* [75] */ function aimEntryDelete(id) {
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getAimEntriesSheet();
  const data = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][0]) === String(id)) { sheet.deleteRow(i+1); break; }
  }
  return { status: 'success' };
}

/* [76] */ function aimEntryUpdate(data) {
  const id = data.id;
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getAimEntriesSheet();
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][0]) === String(id)) {
      sheet.getRange(i+1, 3).setValue(data.date || '');
      sheet.getRange(i+1, 5).setValue(String(data.text || '').trim());
      return { status: 'success' };
    }
  }
  return { status: 'error', message: 'not found' };
}

/* [77] */ function updateLinkedCountdown(aimId, title, deadline) {
  try {
    const cdSheet = getCountdownsSheet();
    const data = cdSheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][2]).trim() === String(title).trim()) {
        cdSheet.getRange(i+1, 3).setValue(title);
        cdSheet.getRange(i+1, 4).setValue(deadline);
        cdSheet.getRange(i+1, 8).setValue(new Date().toISOString());
        break;
      }
    }
  } catch (e) {
    Logger.log('updateLinkedCountdown failed: ' + e);
  }
}

/* ═══════════════════════════════════════════════════════════════
   SECTION P — STREAK
   ═══════════════════════════════════════════════════════════════ */

/* [78] */ function getStreakSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('STREAK_LOG');
  if (!sheet) {
    sheet = ss.insertSheet('STREAK_LOG');
    sheet.appendRow(['Date','Manual','At']);
    sheet.getRange(1,1,1,3).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
}

/* [79] */ function streakLoad() {
  const sheet = getStreakSheet();
  const data = sheet.getDataRange().getValues();
  const manual = {};
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const key = String(d).trim();
    if (!key) continue;
    manual[key] = String(data[i][1] || '').trim().toUpperCase();
  }

  const tz = Session.getScriptTimeZone();
  const today = new Date();
  const days = [];
  for (let i = 29; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const dmy = Utilities.formatDate(d, tz, 'dd-MMM-yyyy');
    const iso = Utilities.formatDate(d, tz, 'yyyy-MM-dd');

    let on = false;
    const man = manual[dmy];
    if (man === 'YES') on = true;
    else if (man === 'NO') on = false;
    else {
      const stats = getDayStatsFromCache(dmy);
      if (stats && stats.total > 0 && stats.pct >= 70) on = true;
    }
    days.push({ date: iso, on: on });
  }

  let cur = 0;
  for (let i = days.length - 1; i >= 0; i--) {
    if (days[i].on) cur++;
    else break;
  }

  let longest = 0, run = 0;
  days.forEach(function (d) {
    if (d.on) { run++; if (run > longest) longest = run; }
    else run = 0;
  });

  const total = days.filter(function (d) { return d.on; }).length;
  const todayIso = Utilities.formatDate(today, tz, 'yyyy-MM-dd');
  const todayOn = days.find(function (d) { return d.date === todayIso; })?.on || false;

  return { status: 'success', days: days, current: cur, longest: longest, total: total, today: todayOn };
}

/* [80] */ function streakToggle(dateDMY, force) {
  if (!dateDMY) return { status: 'error', message: 'no date' };

  const targetDMY = dateToDMY(dateDMY);
  const sheet = getStreakSheet();
  const data = sheet.getDataRange().getValues();
  const val = force ? 'YES' : 'NO';
  const now = new Date().toISOString();

  const matches = [];
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(d).trim() === targetDMY) matches.push(i + 1);
  }

  if (matches.length > 0) {
    const first = matches[0];
    const c1 = sheet.getRange(first, 1);
    c1.setNumberFormat('@');
    c1.setValue(targetDMY);
    sheet.getRange(first, 2).setValue(val);
    sheet.getRange(first, 3).setValue(now);

    for (let k = matches.length - 1; k >= 1; k--) sheet.deleteRow(matches[k]);
  } else {
    const newRow = sheet.getLastRow() + 1;
    const dateCell = sheet.getRange(newRow, 1);
    dateCell.setNumberFormat('@');
    dateCell.setValue(targetDMY);
    sheet.getRange(newRow, 2).setValue(val);
    sheet.getRange(newRow, 3).setValue(now);
  }

  try { sortSheetRowsByDateDesc('STREAK_LOG', 0); } catch (_) {}
  return { status: 'success', date: targetDMY, value: val };
}

/* [81] */ function getDayStatsFromCache(dmy) {
  const grid = readTrackerGrid([dmy]);
  const col = grid.dates[dmy];
  if (col === undefined) return null;
  let yes=0, no=0, part=0;
  for (let r = 0; r < grid.rows.length; r++) {
    const row = grid.rows[r];
    if (row.type !== 'STATUS') continue;
    const val = String(grid.raw[r+1][col] || '').trim().toUpperCase();
    if (val === 'YES') yes++;
    else if (val === 'NO') no++;
    else if (val === 'PARTIAL') part++;
  }
  const total = yes + no + part;
  return { yes: yes, total: total, pct: total > 0 ? Math.round(yes/total*100) : 0 };
}

/* [82] */ function streakHeatmap() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return { status: 'error', message: 'no tracker' };

  const all = sheet.getDataRange().getValues();
  if (!all.length) return { status: 'success', days: [] };

  const dateCols = {};
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const key = String(hv).trim();
    if (key) dateCols[key] = c;
  }

  const tz = Session.getScriptTimeZone();
  const today = new Date(); today.setHours(0,0,0,0);
  const out = [];

  for (let offset = 29; offset >= 0; offset--) {
    const d = new Date(today);
    d.setDate(d.getDate() - offset);
    const dmy = Utilities.formatDate(d, tz, 'dd-MMM-yyyy');
    const iso = Utilities.formatDate(d, tz, 'yyyy-MM-dd');

    const col = dateCols[dmy];
    let yes = 0, no = 0, total = 0;

    if (col !== undefined) {
      for (let r = 1; r < all.length; r++) {
        if (String(all[r][3]).trim() !== 'STATUS') continue;
        const v = String(all[r][col] || '').trim().toUpperCase();
        if (v === 'YES') { yes++; total++; }
        else if (v === 'NO') { no++; total++; }
        else if (v === 'PARTIAL') { yes++; total++; }
      }
    }

    let state = 'nodata';
    if (total > 0) state = (yes > 0) ? 'on' : 'off';

    out.push({ date: iso, dmy: dmy, day: d.getDate(), yes: yes, total: total, state: state });
  }

  return { status: 'success', days: out };
}

/* ═══════════════════════════════════════════════════════════════
   SECTION Q — DAY ABANDON
   ═══════════════════════════════════════════════════════════════ */

const ABANDON_HALF = { water: 6, 'break': 8, hair: 1, face: 1, teeth: 1 };

/* [83] */ function abandonDay(dateDMY, reason) {
  if (!dateDMY) return { status: 'error', message: 'no date' };
  reason = String(reason || '').trim();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tracker = ss.getSheetByName('MASTER TRACKER');
  if (!tracker) return { status: 'error', message: 'no tracker sheet' };

  const today = dateToDMY(dateDMY);
  const all = tracker.getDataRange().getValues();
  if (!all.length) return { status: 'error', message: 'tracker empty' };

  let dateCol = -1;
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === today) { dateCol = c; break; }
  }
  if (dateCol === -1) {
    tracker.insertColumnAfter(5);
    dateCol = 5;
    tracker.getRange(1, dateCol+1).setValue(today);
    tracker.getRange(1, dateCol+1).setNumberFormat('@');
    tracker.getRange(1, dateCol+1).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  let statusWritten = 0;
  for (let r = 1; r < all.length; r++) {
    const area = all[r][2];
    const type = String(all[r][3] || '').trim();
    if (!area) continue;
    if (type === 'STATUS') {
      const cell = tracker.getRange(r+1, dateCol+1);
      cell.setValue('NO');
      cell.setBackground('#f87171').setFontColor('#0f172a').setFontWeight('bold');
      statusWritten++;
    } else if (type === 'REASON') {
      tracker.getRange(r+1, dateCol+1).setValue(reason);
    }
  }

  writeAbandonReasonRow(tracker, today, dateCol, reason);

  const hh = ss.getSheetByName('HEALTH_HABITS');
  if (hh) {
    const data = hh.getDataRange().getValues();
    let row = -1;
    for (let i = 1; i < data.length; i++) {
      const c = data[i][0];
      let cd = '';
      if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      else {
        const s = String(c).trim();
        if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
          const dt = new Date(s);
          if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
        } else cd = s;
      }
      if (cd === today) { row = i+1; break; }
    }
    const savedAt = new Date().toISOString();
    const rowVals = [
      today,
      ABANDON_HALF.water, ABANDON_HALF['break'], ABANDON_HALF.hair, ABANDON_HALF.face, ABANDON_HALF.teeth,
      12, 15, 2, 2, 2,
      savedAt, 0, 0, 0, 0
    ];
    if (row !== -1) {
      hh.getRange(row, 1).setNumberFormat('@');
      hh.getRange(row, 1, 1, rowVals.length).setValues([rowVals]);
    } else {
      const newRow = hh.getLastRow() + 1;
      hh.getRange(newRow, 1).setNumberFormat('@');
      hh.getRange(newRow, 1, 1, rowVals.length).setValues([rowVals]);
    }
  }

  try {
    const r = writeFullFoodDefaults(today);
    Logger.log('abandonDay: wrote food defaults: ' + JSON.stringify(r));
  } catch (e) {
    Logger.log('abandonDay: writeFullFoodDefaults FAILED: ' + e);
  }

  try {
    const foodCal = getFoodCaloriesForDate(today);
    updateNutritionSummary(today, foodCal, 0);
    Logger.log('abandonDay: nutrition updated with food=' + foodCal);
  } catch (e) {
    Logger.log('abandonDay: nutrition update FAILED: ' + e);
  }

  try {
    const cache = CacheService.getScriptCache();
    cache.remove('lifeos_load_' + today);
    cache.remove('dash_v2_today_' + today);
    cache.remove('dash_v2_week_' + today);
    cache.remove('dash_v2_month_' + today);
  } catch (_) {}

  return { status: 'success', tasksMarked: statusWritten, reason: reason };
}

/* [84] */ function unabandonDay(dateDMY) {
  if (!dateDMY) return { status: 'error', message: 'no date' };
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tracker = ss.getSheetByName('MASTER TRACKER');
  if (!tracker) return { status: 'error', message: 'no tracker' };

  const today = dateToDMY(dateDMY);
  const all = tracker.getDataRange().getValues();

  let dateCol = -1;
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === today) { dateCol = c; break; }
  }
  if (dateCol === -1) return { status: 'success', message: 'no column to clear' };

  for (let r = 1; r < all.length; r++) {
    const area = all[r][2];
    const type = String(all[r][3] || '').trim();
    if (!area) continue;
    if (type === 'STATUS') {
      const cell = tracker.getRange(r+1, dateCol+1);
      cell.setValue('YES');
      cell.setBackground('#4ade80').setFontColor('#0f172a').setFontWeight('bold');
    } else if (type === 'REASON') {
      tracker.getRange(r+1, dateCol+1).setValue('');
    }
  }

  clearAbandonReasonRow(tracker, today, dateCol);

  const hh = ss.getSheetByName('HEALTH_HABITS');
  if (hh) {
    const data = hh.getDataRange().getValues();
    let row = -1;
    for (let i = 1; i < data.length; i++) {
      const c = data[i][0];
      let cd = '';
      if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      else {
        const s = String(c).trim();
        if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
          const dt = new Date(s);
          if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
        } else cd = s;
      }
      if (cd === today) { row = i+1; break; }
    }
    const savedAt = new Date().toISOString();
    const rowVals = [today, 0, 0, 0, 0, 0, 12, 15, 2, 2, 2, savedAt, 0, 0, 0, 0];
    if (row !== -1) {
      hh.getRange(row, 1).setNumberFormat('@');
      hh.getRange(row, 1, 1, rowVals.length).setValues([rowVals]);
    } else {
      const newRow = hh.getLastRow() + 1;
      hh.getRange(newRow, 1).setNumberFormat('@');
      hh.getRange(newRow, 1, 1, rowVals.length).setValues([rowVals]);
    }
  }

  try {
    const fl = ss.getSheetByName('FOOD_LOG');
    if (fl) {
      const fdata = fl.getDataRange().getValues();
      for (let i = fdata.length - 1; i >= 1; i--) {
        const c = fdata[i][0];
        let cd = '';
        if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
        else {
          const s = String(c).trim();
          if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
            const dt = new Date(s);
            if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
          } else cd = s;
        }
        if (cd === today) fl.deleteRow(i + 1);
      }
    }
    const ns = ss.getSheetByName('NUTRITION_SUMMARY');
    if (ns) {
      const ndata = ns.getDataRange().getValues();
      for (let i = ndata.length - 1; i >= 1; i--) {
        const c = ndata[i][0];
        let cd = '';
        if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
        else {
          const s = String(c).trim();
          if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
            const dt = new Date(s);
            if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
          } else cd = s;
        }
        if (cd === today) { ns.deleteRow(i + 1); break; }
      }
    }
  } catch (e) {
    Logger.log('unabandon food cleanup failed: ' + e);
  }

  try {
    const cache = CacheService.getScriptCache();
    cache.remove('lifeos_load_' + today);
    cache.remove('dash_v2_today_' + today);
    cache.remove('dash_v2_week_' + today);
    cache.remove('dash_v2_month_' + today);
  } catch (_) {}

  return { status: 'success' };
}

/* [85] */ function getAbandonReasonRowIndex(sheet) {
  const colA = sheet.getRange(1, 1, sheet.getLastRow(), 1).getValues();
  for (let i = 0; i < colA.length; i++) {
    if (String(colA[i][0]).trim() === '📊 ABANDONED REASON') return i + 1;
  }
  return -1;
}

/* [86] */ function writeAbandonReasonRow(sheet, dateDMY, dateCol, reason) {
  let rowIdx = getAbandonReasonRowIndex(sheet);
  if (rowIdx === -1) {
    rowIdx = sheet.getLastRow() + 1;
    sheet.getRange(rowIdx, 1).setValue('📊 ABANDONED REASON')
      .setFontWeight('bold').setBackground('#7f1d1d').setFontColor('#ffffff');
    sheet.getRange(rowIdx, 2).setValue('—');
    sheet.getRange(rowIdx, 3).setValue('');
    sheet.getRange(rowIdx, 4).setValue('REASON');
  }
  const cell = sheet.getRange(rowIdx, dateCol + 1);
  cell.setValue(reason);
  cell.setBackground('#fbbf24').setFontColor('#0f172a').setFontWeight('bold');
}

/* [87] */ function clearAbandonReasonRow(sheet, dateDMY, dateCol) {
  const rowIdx = getAbandonReasonRowIndex(sheet);
  if (rowIdx === -1) return;
  sheet.getRange(rowIdx, dateCol + 1).setValue('').setBackground(null);
}

/* [88] */ function getAbandonReasonForDate(dateDMY) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return { abandoned: false, reason: '' };
  const rowIdx = getAbandonReasonRowIndex(sheet);
  if (rowIdx === -1) return { abandoned: false, reason: '' };

  const today = dateToDMY(dateDMY);
  const all = sheet.getDataRange().getValues();
  let dateCol = -1;
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === today) { dateCol = c; break; }
  }
  if (dateCol === -1) return { abandoned: false, reason: '' };

  const reason = String(all[rowIdx-1][dateCol] || '').trim();
  return { abandoned: reason !== '', reason: reason };
}

/* [89] */ function writeFullFoodDefaults(dateDMY) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateDMY);

  let sheet = ss.getSheetByName('FOOD_LOG');
  if (!sheet) {
    sheet = ss.insertSheet('FOOD_LOG');
    sheet.appendRow(['Date','Meal','Slot','Main Food','Main Qty','Kolambu','Kolambu Qty',
                     'Side 1','Side 1 Qty','Side 2','Side 2 Qty','Time','Calories','Protein']);
    sheet.getRange(1,1,1,14).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  // Wipe all rows for this date
  const data = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) sheet.deleteRow(i + 1);
  }

  const MEALS = ['Breakfast','Morning Break','Lunch','Evening Snack','Dinner'];
  const MEAL_TIMES = {
    'Breakfast': '08.15', 'Morning Break': '10.15', 'Lunch': '13.00',
    'Evening Snack': '15.00', 'Dinner': '20.00'
  };

  const defaults = getFoodDefaults();
  const db = getFoodDatabase();
  const rows = [];
  let totalCal = 0;

  MEALS.forEach(function (meal) {
    const mealDefs = defaults[meal] || {};
    const time = MEAL_TIMES[meal] || '';
    ['main','kolambu','side1','side2'].forEach(function (slot) {
      const def = mealDefs[slot];
      if (!def || !def.name) return;
      const info = db[def.name] || { calories:0, protein:0 };
      const qty = def.qty || 1;
      const cal = (info.calories || 0) * qty;
      const pro = (info.protein  || 0) * qty;
      rows.push([today, meal, slot, def.name, qty, '','','','','','', time, Math.round(cal), Math.round(pro)]);
      totalCal += cal;
    });
  });

  if (rows.length) {
    const start = sheet.getLastRow() + 1;
    sheet.getRange(start, 1, rows.length, 1).setNumberFormat('@');
    const range = sheet.getRange(start, 1, rows.length, 14);
    range.setValues(rows);
    sheet.getRange(start, 13, rows.length, 2).setNumberFormat('#,##0');
  }

  Logger.log('writeFullFoodDefaults: ' + rows.length + ' rows for ' + today + ' (' + Math.round(totalCal) + ' cal)');
  return { rows: rows.length, calories: Math.round(totalCal) };
}

