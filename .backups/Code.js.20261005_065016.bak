/* [69] */ function getAimsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('AIMS');
  if (!sheet) {
    sheet = ss.insertSheet('AIMS');
    sheet.appendRow(['ID','Emoji','Title','Notes','StartDate','CreatedAt']);
    sheet.getRange(1,1,1,6).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
}

/* [70] */ function getAimEntriesSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('AIM_ENTRIES');
  if (!sheet) {
    sheet = ss.insertSheet('AIM_ENTRIES');
    sheet.appendRow(['ID','AimID','Date','Type','Text','CreatedAt']);
    sheet.getRange(1,1,1,6).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
