function DIAGNOSE_october_workPlan() {
  Logger.log('═══ RAW SHEET DUMP — October 2026 rows ═══');
  const sheet = getWorkSheet();
  const data = sheet.getDataRange().getValues();
  Logger.log('Total rows: ' + data.length);
  Logger.log('Header: ' + JSON.stringify(data[0]));

  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun',
                  'Jul','Aug','Sep','Oct','Nov','Dec'];

  let octCount = 0;
  for (let i = 1; i < data.length; i++) {
    const d = data[i][0];
    if (!d) continue;

    let dmy = '';
    if (d instanceof Date) dmy = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else dmy = String(d).trim();

    // Show the first 5 raw values
    if (octCount < 5) {
      Logger.log('Row ' + (i+1) + ' raw: ' + JSON.stringify(data[i].slice(0, 8)));
    }

    let m = dmy.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
    let day, mon, yr;
    if (m) { day = parseInt(m[1],10); mon = m[2]; yr = parseInt(m[3],10); }
    else {
      m = dmy.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2})$/);
      if (!m) {
        if (octCount < 5) Logger.log('  ❌ Regex did not match: "' + dmy + '"');
        continue;
      }
      day = parseInt(m[1],10); mon = m[2]; yr = 2000 + parseInt(m[3],10);
    }

    if (mon === 'Oct' && yr === 2026) {
      octCount++;
      if (octCount <= 3) {
        Logger.log('  ✅ MATCH: day=' + day + ' mon=' + mon + ' yr=' + yr);
      }
    }
  }
  Logger.log('October 2026 matches: ' + octCount);

  Logger.log('');
  Logger.log('═══ workPlanLoad(2026, 9) OUTPUT ═══');
  const res = workPlanLoad(2026, 9);
  Logger.log('status: ' + res.status);
  Logger.log('year: ' + res.year);
  Logger.log('month: ' + res.month);
  Logger.log('rows.length: ' + res.rows.length);
  if (res.rows.length > 0) {
    Logger.log('First row:');
    Logger.log(JSON.stringify(res.rows[0]));
    Logger.log('Last row:');
    Logger.log(JSON.stringify(res.rows[res.rows.length - 1]));
  }

  Logger.log('');
  Logger.log('═══ workPlanLoad(2026, 8) — September ═══');
  const sep = workPlanLoad(2026, 8);
  Logger.log('rows.length: ' + sep.rows.length);
}
