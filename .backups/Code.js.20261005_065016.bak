/* ─── Trivial triggers setup ─── */
function MIGRATE_notesAddOffice() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('EVERYDAY_NOTES');
  if (!sheet) { Logger.log('No EVERYDAY_NOTES sheet'); return; }

  const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  Logger.log('Current header: ' + JSON.stringify(header));

  if (String(header[5] || '').trim() === 'Office') {
    Logger.log('Already migrated');
    return;
  }

  // Old layout: [Date, Positive, Improve, Common, Learned, SavedAt]
  // New layout: [Date, Positive, Improve, Common, Learned, Office, SavedAt]
  if (String(header[5] || '').trim() === 'SavedAt') {
    sheet.insertColumnBefore(6);
    sheet.getRange(1, 6).setValue('Office');
    sheet.getRange(1, 1, 1, 7).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    Logger.log('✅ Migrated — column F is now Office');
  } else {
    // Something else is at column F — just relabel it
    sheet.getRange(1, 6).setValue('Office');
    sheet.getRange(1, 1, 1, 7).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    Logger.log('⚠️ Column F relabeled — verify manually');
  }
}
function VERIFY_workSheetHeader() {
  const sheet = getWorkSheet();
  const hdr = sheet.getRange(1, 1, 1, 8).getValues()[0];
  Logger.log('Header row: ' + JSON.stringify(hdr));

  const expected = ['Date','DAY','Planned Report','Planned Occurrence',
                    'Actual Report','Actual Occurrence','ADDITIONAL REPORT','Skip'];
  let ok = true;
  for (let i = 0; i < 8; i++) {
    const actual = String(hdr[i] || '').trim();
    if (actual !== expected[i]) {
      Logger.log('❌ Col ' + (i+1) + ': expected "' + expected[i] + '", found "' + actual + '"');
      ok = false;
    }
  }
  if (ok) Logger.log('✅ Header matches expected layout');
}
