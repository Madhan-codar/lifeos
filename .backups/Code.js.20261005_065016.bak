/**
 * LifeOS Tracker — Full JSON API backend
 * Frontend is a standalone HTML file that calls this via fetch().
 *
 * ═══════════════════════════════════════════════════════════════════
 *  FUNCTION INDEX
 * ═══════════════════════════════════════════════════════════════════
 *  A. ENTRY POINTS                      [01]–[04]
 *  B. AUTO-SAVE + LOAD                  [05]–[06]
 *  C. DATE / TIME HELPERS               [07]–[20]
 *  D. TASK HELPERS                      [21]–[22]
 *  E. TRACKER                           [23]–[25]
 *  F. FOOD                              [26]–[30]
 *  G. NUTRITION                         [31]–[35]
 *  H. HEALTH HABITS                     [36]–[39]
 *  I. NOTES                             [40]–[43]
 *  J. CALENDAR ITEMS                    [44]–[45]
 *  K. ROUTINE → GOOGLE CALENDAR         [46]–[49]
 *  L. HEALTH → GOOGLE CALENDAR          [50]–[53]
 *  M. WISHES → GOOGLE CALENDAR          [54]–[58]
 *  N. COUNTDOWNS                        [59]–[67]
 *  O. AIMS                              [68]–[76]
 *  P. STREAK                            [77]–[81]
 *  Q. DAY ABANDON                       [82]–[88]
 *  R. TIME SKIPS                        [89]–[98]
 *  S. DASHBOARD                         [99]–[104]
 *  T. ORCHESTRATOR                      [105]
 *  U. SORT / MIGRATE HELPERS            [106]–[109]
 * ═══════════════════════════════════════════════════════════════════
 */

/* ═══════════════════════════════════════════════════════════════
   SECTION A — ENTRY POINTS
   ═══════════════════════════════════════════════════════════════ */

/* [01] */   function doGet(e) {
    // TEST_MARKER — remove after verifying
  const action = (e && e.parameter && e.parameter.action) || 'test';
  const dateParam = e && e.parameter && e.parameter.date;
  const date = dateParam || Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd-MMM-yyyy');

  let result;
  try {
    if (action === 'test') {
      result = { status: 'success', message: 'API is connected!' };
    } else if (action === 'load') {
      result = loadPayload(date);
    } else if (action === 'food-db') {
      result = { status: 'success', db: getFoodDatabase() };
    } else {
      result = { status: 'error', message: 'Unknown action: ' + action };
    }
  } catch (err) {
    result = { status: 'error', message: err.toString() };
  }

  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

/* [02] */ function doPost(e) {
  try {
    const payload = JSON.parse(e.postData.contents);
    const action = payload.action;
    const date = payload.date || Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const data = payload.data || {};

    try { CacheService.getScriptCache().remove('lifeos_load_' + date); } catch (_) {}
    try {
      const cache = CacheService.getScriptCache();
      ['today', 'week', 'month'].forEach(function (p) {
        cache.remove('dash_v2_' + p + '_' + date);
      });
    } catch (_) {}

    let res;
    switch (action) {
      case 'load':                res = loadPayload(date); break;
      case 'save-tracker':        saveTrackerForDate(data.submissions || [], date); res = { status: 'success' }; break;
      case 'save-food':           res = saveFoodLogForDate(data.entries || [], date); res.status = 'success'; break;
      case 'save-health-habits':  res = saveMicroHabits(data, date); res.status = 'success'; break;
      case 'save-notes':          res = saveNotes(date, data.notes || {}); res.status = 'success'; break;
      case 'save-calendar-items': res = saveCalendarItems(data.items || []); res.status = 'success'; break;
      case 'dashboard':           res = getDashboardData(data.period || 'today', date); break;
      case 'autosave':            res = autoSave(date, data); break;
      case 'countdown-load':      res = countdownLoad(); break;
      case 'countdown-save':      res = countdownSave(data); break;
      case 'countdown-reminders': res = countdownCreateReminders(data); break;
      case 'countdown-delete':    res = countdownDelete(data.id); break;
      case 'countdown-status':    res = countdownStatus(data.id, data.status); break;
      case 'reminder-sync-all':   res = reminderSyncAll(); break;
      case 'five-slot-backfill':  res = reminderSyncAll(); break;
      case 'aim-load':            res = aimLoad(); break;
      case 'work-notes-save':        res = workNotesSave(data); break;
      case 'aim-save':
        res = aimSave(data);
        if (res && res.status === 'success' && data.deadline) {
          try { countdownSyncAllReminders(); } catch (_) {}
        }
        break;
      case 'aim-delete':          res = aimDelete(data.id); break;
      case 'aim-entry-add':       res = aimEntryAdd(data); break;
      case 'aim-entry-delete':    res = aimEntryDelete(data.id); break;
      case 'streak-load':         res = streakLoad(); break;
      case 'streak-toggle':       res = streakToggle(data.date, data.force); break;
      case 'aim-entry-update':    res = aimEntryUpdate(data); break;
      case 'abandon-day':         res = abandonDay(date, data.reason || ''); break;
      case 'unabandon-day':       res = unabandonDay(date); break;
      case 'streak-heatmap':      res = streakHeatmap(); break;
      case 'time-skips-load':     res = timeSkipsLoad(); break;
      case 'time-skips-save':     res = timeSkipSave(data); break;
      case 'time-skips-delete':   res = timeSkipDelete(data.id); break;
      case 'work-plan-load':         res = workPlanLoad(data.year, data.month); break;
      case 'work-actual-save':       res = workActualSave(data); break;
      case 'work-additional-add':    res = workAdditionalAdd(data); break;
      case 'work-additional-update': res = workAdditionalUpdate(data); break;
      case 'work-additional-delete': res = workAdditionalDelete(data); break;
      default:                    res = { status: 'error', message: 'Unknown action: ' + action };
    }
    try { remSyncAllToCalendar(); } catch (_) {}
    return jsonResponse(res);
  } catch (err) {
    Logger.log('POST error: ' + err);
    return jsonResponse({ status: 'error', message: err.toString() });
  }
}

/* [03] */ function doOptions(e) {
  return ContentService.createTextOutput('').setMimeType(ContentService.MimeType.TEXT);
}

/* [04] */ function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

/* ═══════════════════════════════════════════════════════════════
   SECTION B — AUTO-SAVE + LOAD
   ═══════════════════════════════════════════════════════════════ */

/* [05] */ function autoSave(date, data) {
  if (!date || !data) return { status: 'error', message: 'missing' };
  const t = data.tab;
  try {
    if (t === 'routine' && data.submissions) {
      saveTrackerForDate(data.submissions, date);
    } else if (t === 'health' && data.health) {
      saveMicroHabits(data.health, date);
    } else if (t === 'food' && data.entries) {
      saveFoodLogForDate(data.entries, date);
    } else if (t === 'notes' && data.notes) {
      saveNotes(date, data.notes);
    } else if (t === 'rem' && data.items) {
      saveCalendarItems(data.items);
    } else {
      return { status: 'error', message: 'unknown tab: ' + t };
    }
    try { CacheService.getScriptCache().remove('lifeos_load_' + date); } catch (_) {}
    return { status: 'success', tab: t, at: new Date().toISOString() };
  } catch (e) {
    return { status: 'error', message: e.toString() };
  }
}

/* [06] */ function loadPayload(dateDMY) {
  const cache = CacheService.getScriptCache();
  const key = 'lifeos_load_' + dateDMY;
  const cached = cache.get(key);
  if (cached) return JSON.parse(cached);

  const tracker = loadTrackerForDate(dateDMY);
  const result = {
    status: 'success',
    date: dateDMY,
    tasks: getTasksForDate(dateDMY),
    submissions: tracker.submissions,
    foodLog: getFoodLogForDate(dateDMY),
    foodDefaults: getFoodDefaults(),
    foodDb: getFoodDatabase(),
    workoutBurn: computeBurnFromSubs(tracker.submissions),
    healthHabits: getHealthHabitsForDate(dateDMY),
    healthLog: getHealthLogForDate(dateDMY),
    notes: getNotesForDate(dateDMY),
    notesHistory: getNotesHistory(7),
    calendarItems: getCalendarItems(),
    abandoned: getAbandonReasonForDate(dateDMY).abandoned,
    abandonReason: getAbandonReasonForDate(dateDMY).reason
  };
  try { cache.put(key, JSON.stringify(result), 60); } catch (_) {}
  return result;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION C — DATE / TIME HELPERS
   ═══════════════════════════════════════════════════════════════ */

/* [07] */ function getWeekNumberForDate(date) {
  const first = new Date(date.getFullYear(), 0, 1);
  const past  = (date - first) / 86400000;
  return Math.ceil((past + first.getDay() + 1) / 7);
}

/* [08] */ function parseDays(str) {
  const map = { SUN:0,SUNDAY:0,MON:1,MONDAY:1,TUE:2,TUESDAY:2,WED:3,WEDNESDAY:3,
                THU:4,THURSDAY:4,FRI:5,FRIDAY:5,SAT:6,SATURDAY:6 };
  const out = [];
  for (const p of str.split(',')) {
    const u = p.trim().toUpperCase();
    if (map[u] !== undefined && out.indexOf(map[u]) === -1) out.push(map[u]);
  }
  return out;
}

/* [09] */ function checkAlternateDay(rule, dayOfWeek, isWeekA) {
  if (!rule) return true;
  let days = [], weekFilter = null;
  if (rule.indexOf('|') !== -1) {
    const parts = rule.split('|');
    days = parseDays(parts[0]);
    weekFilter = parts[1];
  } else if (rule.indexOf('Week') === 0) {
    weekFilter = rule;
    days = [0,1,2,3,4,5,6];
  } else {
    days = parseDays(rule);
  }
  if (weekFilter === 'WeekA' && !isWeekA) return false;
  if (weekFilter === 'WeekB' && isWeekA)  return false;
  if (days.length > 0 && days.indexOf(dayOfWeek) === -1) return false;
  return true;
}

/* [10] */ function dateToISO(dateStr) {
  return Utilities.formatDate(new Date(dateStr), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

/* [11] */ function dateToDMY(dateStr) {
  if (typeof dateStr === 'string' && /^\d{1,2}-[A-Za-z]{3}-\d{4}$/.test(dateStr.trim())) {
    return dateStr.trim();
  }
  return Utilities.formatDate(new Date(dateStr), Session.getScriptTimeZone(), 'dd-MMM-yyyy');
}

/* [12] */ function parseDMY(dmy) {
  if (dmy === null || dmy === undefined || dmy === '') return null;

  if (typeof dmy === 'object' && typeof dmy.getTime === 'function') {
    try { return [dmy.getFullYear(), dmy.getMonth(), dmy.getDate()]; } catch (_) {}
  }

  const s = String(dmy).trim();

  if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
    const dt = new Date(s);
    if (isNaN(dt.getTime())) return null;
    return [dt.getUTCFullYear(), dt.getUTCMonth(), dt.getUTCDate()];
  }

  if (/^[A-Z][a-z]{2}\s+[A-Z][a-z]{2}\s+\d{1,2}\s+\d{4}/.test(s)) {
    const dt = new Date(s);
    if (isNaN(dt.getTime())) return null;
    return [dt.getFullYear(), dt.getMonth(), dt.getDate()];
  }

  const months = { Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11 };
  const parts = s.split('-');
  if (parts.length !== 3) return null;
  const d = parseInt(parts[0], 10);
  const m = months[parts[1]];
  const y = parseInt(parts[2], 10);
  if (isNaN(y) || m === undefined || isNaN(d)) return null;
  return [y, m, d];
}

/* [13] */ function parseCountdownDMY(dmy) {
  if (dmy === null || dmy === undefined || dmy === '') return null;

  if (typeof dmy === 'object' && typeof dmy.getTime === 'function') {
    try { return { y: dmy.getFullYear(), m0: dmy.getMonth(), d: dmy.getDate() }; } catch (_) {}
  }

  const s = String(dmy).trim();

  if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
    const dt = new Date(s);
    if (isNaN(dt.getTime())) return null;
    return { y: dt.getUTCFullYear(), m0: dt.getUTCMonth(), d: dt.getUTCDate() };
  }

  if (/^[A-Z][a-z]{2}\s+[A-Z][a-z]{2}\s+\d{1,2}\s+\d{4}/.test(s)) {
    const dt = new Date(s);
    if (isNaN(dt.getTime())) return null;
    return { y: dt.getFullYear(), m0: dt.getMonth(), d: dt.getDate() };
  }

  const months = { Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11 };
  const parts = s.split('-');
  if (parts.length !== 3) return null;
  const d = parseInt(parts[0], 10);
  const m0 = months[parts[1]];
  const y = parseInt(parts[2], 10);
  if (isNaN(d) || m0 === undefined || isNaN(y)) return null;
  return { y: y, m0: m0, d: d };
}

/* [14] */ function normalizeDateForOutput(val) {
  if (val === null || val === undefined || val === '') return '';
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  if (typeof val === 'object' && typeof val.getTime === 'function') {
    try {
      const d = String(val.getDate()).padStart(2,'0');
      const m = MONTHS[val.getMonth()];
      const y = val.getFullYear();
      if (y && m !== undefined && d !== 'NaN') return d + '-' + m + '-' + y;
    } catch (_) {}
  }

  const s = String(val).trim();

  if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
    const dt = new Date(s);
    if (!isNaN(dt.getTime())) {
      const d = String(dt.getUTCDate()).padStart(2,'0');
      const m = MONTHS[dt.getUTCMonth()];
      const y = dt.getUTCFullYear();
      return d + '-' + m + '-' + y;
    }
  }

  if (/^[A-Z][a-z]{2}\s+[A-Z][a-z]{2}\s+\d{1,2}\s+\d{4}/.test(s)) {
    const dt = new Date(s);
    if (!isNaN(dt.getTime())) {
      const d = String(dt.getDate()).padStart(2,'0');
      const m = MONTHS[dt.getMonth()];
      const y = dt.getFullYear();
      return d + '-' + m + '-' + y;
    }
  }

  if (/^\d{1,2}-[A-Za-z]{3}-\d{4}$/.test(s)) return s;

  const dt2 = new Date(s);
  if (!isNaN(dt2.getTime())) {
    const d = String(dt2.getDate()).padStart(2,'0');
    const m = MONTHS[dt2.getMonth()];
    const y = dt2.getFullYear();
    return d + '-' + m + '-' + y;
  }

  return s;
}

/* [15] */ function parseTimeRange(range) {
  if (!range) return null;
  const s = String(range);
  const sep = s.indexOf('–') !== -1 ? '–' : (s.indexOf('—') !== -1 ? '—' : '-');
  const parts = s.split(sep).map(function (x) { return x.trim(); });
  if (parts.length < 2) return null;
  const a = parseClock(parts[0]);
  const b = parseClock(parts[1]);
  if (!a || !b) return null;
  return { startH: a.h, startM: a.m, endH: b.h, endM: b.m };
}

/* [16] */ function parseClock(str) {
  const m = String(str).match(/(\d{1,2}):?(\d{2})?\s*(AM|PM)?/i);
  if (!m) return null;
  let h = parseInt(m[1], 10);
  const mi = parseInt(m[2] || '0', 10);
  const ap = (m[3] || '').toUpperCase();
  if (ap === 'PM' && h !== 12) h += 12;
  if (ap === 'AM' && h === 12) h = 0;
  return { h: h, m: mi };
}

/* [17] */ function parseRemTime(val) {
  if (val === '' || val === null || val === undefined) return { h: 9, m: 0 };
  if (typeof val === 'number') {
    const h = Math.floor(val);
    const m = Math.round((val - h) * 60);
    return { h: h, m: m };
  }
  const s = String(val).trim();
  const parts = s.split('.');
  const h = parseInt(parts[0], 10) || 9;
  const m = parseInt(parts[1] || '0', 10) || 0;
  return { h: h, m: m };
}

/* [18] */ function parseStartMinForSkip(plannedTime) {
  if (!plannedTime) return 0;
  const first = String(plannedTime).split(/[–\-—]/)[0].trim();
  const m = first.match(/(\d{1,2}):?(\d{2})?\s*(AM|PM)?/i);
  if (!m) return 0;
  let h = parseInt(m[1], 10);
  const mi = parseInt(m[2] || '0', 10);
  const ap = (m[3] || '').toUpperCase();
  if (ap === 'PM' && h !== 12) h += 12;
  if (ap === 'AM' && h === 12) h = 0;
  return h * 60 + mi;
}

/* [19] */ function hhmmToMin(val) {
  if (val === '' || val === null || val === undefined) return null;
  if (typeof val === 'number') {
    return Math.floor(val) * 60 + Math.round((val - Math.floor(val)) * 60);
  }
  const s = String(val).trim().replace(':', '.');
  const parts = s.split('.');
  const h = parseInt(parts[0], 10);
  const m = parseInt(parts[1] || '0', 10);
  if (isNaN(h)) return null;
  return h * 60 + (m || 0);
}

/* [20] */ function safeJsonParse(str, fallback) {
  if (!str) return fallback;
  try { return JSON.parse(str); } catch (_) { return fallback; }
}

/* ═══════════════════════════════════════════════════════════════
   SECTION D — TASK HELPERS
   ═══════════════════════════════════════════════════════════════ */

/* [21] */ function getTasksForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER DATA');
  if (!sheet) return [];

  const data = sheet.getDataRange().getValues();
  const tasks = [];
  const selectedDate = new Date(dateString);
  const dayOfWeek    = selectedDate.getDay();
  const weekNumber   = getWeekNumberForDate(selectedDate);
  const isWeekA      = (weekNumber % 2 === 0);

  for (let i = 1; i < data.length; i++) {
    if (data[i][0] && data[i][2]) {
      const alternateDay = data[i][4] || '';
      let show = true;
      if (alternateDay) show = checkAlternateDay(alternateDay, dayOfWeek, isWeekA);
      if (show) {
        tasks.push({
          id: String(data[i][2]).toLowerCase().replace(/\s+/g, '-'),
          head: data[i][0],
          subCategory: data[i][1],
          area: data[i][2],
          plannedTime: data[i][3],
          reference: String(data[i][6] || '').trim()
        });
      }
    }
  }
  return tasks;
}

/* [22] */ function getAllTasksEver() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER DATA');
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  const tasks = [];
  const seen = {};
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] && data[i][2]) {
      const area = String(data[i][2]).trim();
      if (seen[area]) continue;
      seen[area] = true;
      tasks.push({
        id: area.toLowerCase().replace(/\s+/g, '-'),
        head: data[i][0],
        subCategory: data[i][1],
        area: area,
        plannedTime: data[i][3],
        alternateDays: data[i][4] || ''
      });
    }
  }
  return tasks;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION E — TRACKER
   ═══════════════════════════════════════════════════════════════ */

/* [23] */ function loadTrackerForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  const tasks = getTasksForDate(dateString);
  if (!sheet) return { submissions: [], tasks: tasks };

  const today = dateToDMY(dateString);
  const all = sheet.getDataRange().getValues();
  if (!all.length) return { submissions: [], tasks: tasks };

  let dateCol = -1;
  for (let col = 5; col < all[0].length; col++) {
    let hv = all[0][col];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === today) { dateCol = col; break; }
  }
  if (dateCol === -1) return { submissions: [], tasks: tasks };

  const subs = [];
  for (let row = 1; row < all.length; row++) {
    const area = all[row][2];
    const type = all[row][3];
    const val  = all[row][dateCol];
    if (type === 'STATUS' && val) {
      let plan = '', actual = '', reason = '';
      for (let r = row + 1; r < Math.min(row + 4, all.length); r++) {
        if (String(all[r][2]).trim() === String(area).trim()) {
          if (all[r][3] === 'PLAN')   plan   = all[r][dateCol] || '';
          if (all[r][3] === 'ACTUAL') actual = all[r][dateCol] || '';
          if (all[r][3] === 'REASON') reason = all[r][dateCol] || '';
        }
      }
      subs.push({
        area: area,
        status: String(val).trim().toUpperCase(),
        plannedTime: plan,
        actualTime: actual,
        reason: reason
      });
    }
  }
  return { submissions: subs, tasks: tasks };
}

/* [24] */ function saveTrackerForDate(submissions, dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('MASTER TRACKER');

  if (!sheet) {
    sheet = ss.insertSheet('MASTER TRACKER');
    sheet.getRange(1,1,1,5).setValues([['Head','Sub Category','Area','Type','Alternate Days']]);
    sheet.getRange(1,1,1,5).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  const master = getAllTasksEver();
  let all = sheet.getDataRange().getValues();
  const existing = {};
  for (let row = 1; row < all.length; row++) {
    if (all[row][2] && all[row][3]) existing[all[row][2] + '|' + all[row][3]] = true;
  }

  let lastRow = sheet.getLastRow();
  const newRows = [];
  for (const t of master) {
    ['STATUS','PLAN','ACTUAL','REASON'].forEach(function (type) {
      const key = t.area + '|' + type;
      if (!existing[key]) {
        newRows.push([t.head, t.subCategory, t.area, type, t.alternateDays]);
        existing[key] = true;
      }
    });
  }
  if (newRows.length) {
    sheet.getRange(lastRow + 1, 1, newRows.length, 5).setValues(newRows);
  }

  all = sheet.getDataRange().getValues();
  let todayCol = -1;
  for (let col = 5; col < all[0].length; col++) {
    let hv = all[0][col];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === today) { todayCol = col + 1; break; }
  }
  if (todayCol === -1) {
    sheet.insertColumnAfter(5);
    todayCol = 6;
    sheet.getRange(1, todayCol).setValue(today);
    sheet.getRange(1, todayCol).setNumberFormat('@');
    sheet.getRange(1, todayCol).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, todayCol, sheet.getLastRow()-1, 1).clearContent().clearFormat();
  }

  for (const sub of submissions) {
    for (let row = 1; row < all.length; row++) {
      if (String(all[row][2]).trim() === String(sub.area).trim()) {
        const type = all[row][3];
        const cell = sheet.getRange(row + 1, todayCol);
        if (type === 'STATUS') {
          cell.setValue(sub.status);
          if (sub.status === 'YES')          cell.setBackground('#4ade80').setFontColor('#0f172a').setFontWeight('bold');
          else if (sub.status === 'NO')      cell.setBackground('#f87171').setFontColor('#0f172a').setFontWeight('bold');
          else if (sub.status === 'PARTIAL') cell.setBackground('#fbbf24').setFontColor('#0f172a').setFontWeight('bold');
        } else if (type === 'PLAN')   cell.setValue(sub.plannedTime || '');
        else if (type === 'ACTUAL')   cell.setValue(sub.actualTime  || '');
        else if (type === 'REASON')   cell.setValue(sub.reason      || '');
      }
    }
  }

  updateNutritionSummaryFromTracker(dateString, submissions);
  updateTrackerSummary(todayCol);

  try { sortTrackerDateColumns(); } catch (e) { Logger.log('sort failed: ' + e); }

  return { success: true };
}

/* [25] */ function updateTrackerSummary(dateCol) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return;

  const lastRow = sheet.getLastRow();
  let yes = 0, no = 0, partial = 0;
  const data = sheet.getRange(2, dateCol, lastRow - 1, 1).getValues();
  for (let i = 0; i < data.length; i++) {
    const v = String(data[i][0]).trim().toUpperCase();
    if (v === 'YES') yes++;
    else if (v === 'NO') no++;
    else if (v === 'PARTIAL') partial++;
  }
  const total = yes + no + partial;
  const rate  = total > 0 ? yes / total : 0;

  let summaryRow = -1;
  const colA = sheet.getRange(1, 1, sheet.getLastRow(), 1).getValues();
  for (let i = 0; i < colA.length; i++) {
    if (String(colA[i][0]).trim() === '📊 SUMMARY') { summaryRow = i + 1; break; }
  }
  if (summaryRow === -1) {
    summaryRow = sheet.getLastRow() + 2;
    sheet.getRange(summaryRow, 1).setValue('📊 SUMMARY');
    sheet.getRange(summaryRow + 1, 1).setValue('TOTAL YES:');
    sheet.getRange(summaryRow + 2, 1).setValue('TOTAL NO:');
    sheet.getRange(summaryRow + 3, 1).setValue('TOTAL PARTIAL:');
    sheet.getRange(summaryRow + 4, 1).setValue('COMPLETION RATE:');
  }
  sheet.getRange(summaryRow + 1, dateCol).setValue(yes).setFontSize(16).setFontWeight('bold').setHorizontalAlignment('center').setBackground('#4ade80');
  sheet.getRange(summaryRow + 2, dateCol).setValue(no).setFontSize(16).setFontWeight('bold').setHorizontalAlignment('center').setBackground('#f87171');
  sheet.getRange(summaryRow + 3, dateCol).setValue(partial).setFontSize(16).setFontWeight('bold').setHorizontalAlignment('center').setBackground('#22d3ee');
  sheet.getRange(summaryRow + 4, dateCol).setValue(rate).setNumberFormat('0%').setFontSize(16).setFontWeight('bold').setHorizontalAlignment('center').setBackground('#f8fafc');
}

