const WORK_REPORT_OPTIONS = [
  'INPUT',
  'TIME',
  'CONSOLIDATE',
  'DRS VISIT',
  'DOCTOR YEAR WISE',
  'TP VS ACTUAL',
  'CHECK IN',
  'SAMPLE',
  'INPUT UPLOAD',
  'SAMPLE UPLOAD',
  'A DRS VISIT',
  'ADD DELETE',
  'CONSOLIDATE & ATTENDANCE',
  'ADD DELETE & KARIMNAGARE'
];

/* Get or create the WORK PLAN VS ACTUAL sheet */
function getWorkSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('WORK PLAN VS ACTUAL');
  if (!sheet) {
    sheet = ss.insertSheet('WORK PLAN VS ACTUAL');
    sheet.appendRow(['Date','DAY','Planned Report','Planned Occurrence',
                    'Actual Report','Actual Occurrence','ADDITIONAL REPORT','NOTES','Skip']);
    sheet.getRange(1,1,1,8).setFontWeight('bold')
      .setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
}
/* [26] */ function getFoodDatabase() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('FOOD_CALORIES_DB');
  if (!sheet) return {};
  const data = sheet.getDataRange().getValues();
  const foods = {};
  for (let i = 1; i < data.length; i++) {
    const mealType = data[i][0];
    if (!mealType || mealType === '') break;
    const name = data[i][1];
    if (!name || name === '') continue;
    foods[name] = {
      mealType: String(mealType).trim(),
      category: data[i][2] || '',
      subCategory: data[i][3] || '',
      calories: Number(data[i][5]) || 0,
      protein: Number(data[i][6]) || 0,
      defaultQty: Number(data[i][7]) || 1,
      isDefault: String(data[i][8] || '').trim().toUpperCase() === 'YES'
    };
  }
  return foods;
}

/* [27] */ function getFoodDefaults() {
  const db = getFoodDatabase();
  const meals = ['Breakfast','Morning Break','Lunch','Evening Snack','Dinner'];
  const out = {};
  meals.forEach(function (m) { out[m] = {}; });

  Object.keys(db).forEach(function (name) {
    const f = db[name];
    if (!f.isDefault) return;
    const mealTypes = String(f.mealType || '').split(',').map(x => x.trim());
    let slot = null;
    if (f.category === 'Main') slot = 'main';
    else if (f.category === 'Gravy' && f.subCategory === 'Kolambu') slot = 'kolambu';
    else if (f.category === 'Side' && f.subCategory === 'Side1') slot = 'side1';
    else if (f.category === 'Side' && f.subCategory === 'Side2') slot = 'side2';
    if (!slot) return;
    mealTypes.forEach(function (m) {
      if (!out[m]) return;
      if (!out[m][slot]) {
        out[m][slot] = { name: name, qty: f.defaultQty || 1 };
      }
    });
  });
  return out;
}

/* [28] */ function getFoodLogForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  const sheet = ss.getSheetByName('FOOD_LOG');
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  const entries = [];
  for (let i = 1; i < data.length; i++) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) {
      entries.push({
        meal: data[i][1], slot: data[i][2], mainFood: data[i][3], mainQty: data[i][4],
        kolambu: data[i][5], kolambuQty: data[i][6],
        side1: data[i][7], side1Qty: data[i][8],
        side2: data[i][9], side2Qty: data[i][10],
        time: data[i][11], calories: Number(data[i][12]) || 0, protein: Number(data[i][13]) || 0
      });
    }
  }
  return entries;
}

/* [29] */ function saveFoodLogForDate(entries, dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('FOOD_LOG');

  if (!sheet) {
    sheet = ss.insertSheet('FOOD_LOG');
    sheet.appendRow(['Date','Meal','Slot','Main Food','Main Qty','Kolambu','Kolambu Qty','Side 1','Side 1 Qty','Side 2','Side 2 Qty','Time','Calories','Protein']);
    sheet.getRange(1,1,1,14).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  // Wipe existing rows for this date
  const data = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) sheet.deleteRow(i + 1);
  }

  const rows = [];
  let totalCal = 0;
  for (const e of entries) {
    if (!e.mainFood) continue;
    rows.push([
      today, e.meal || '', e.slot || 'main',
      e.mainFood, e.mainQty || 1,
      e.kolambu || '', e.kolambuQty || 1,
      e.side1 || '', e.side1Qty || 1,
      e.side2 || '', e.side2Qty || 1,
      e.time || '', e.calories || 0, e.protein || 0
    ]);
    totalCal += Number(e.calories) || 0;
  }

  if (rows.length > 0) {
    const start = sheet.getLastRow() + 1;
    sheet.getRange(start, 1, rows.length, 1).setNumberFormat('@');
    const range = sheet.getRange(start, 1, rows.length, 14);
    range.setValues(rows);
    sheet.getRange(start, 13, rows.length, 2).setNumberFormat('#,##0');
  }

  const workoutBurn = getWorkoutBurnForDate(dateString);
  updateNutritionSummary(dateString, totalCal, workoutBurn);
  try { sortSheetRowsByDateDesc('FOOD_LOG', 0); } catch (_) {}
  return { count: rows.length, totalCalories: totalCal };
}

/* [30] */ function getFoodCaloriesForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  const sheet = ss.getSheetByName('FOOD_LOG');
  if (!sheet) return 0;
  const data = sheet.getDataRange().getValues();
  let total = 0;
  for (let i = 1; i < data.length; i++) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) total += Number(data[i][12]) || 0;
  }
  return total;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION G — NUTRITION
   ═══════════════════════════════════════════════════════════════ */

/* [31] */ function computeBurnFromSubs(subs) {
  if (!subs || !subs.length) return 0;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER DATA');
  if (!sheet) return 0;

  const data = sheet.getDataRange().getValues();
  const burnByArea = {};
  for (let i = 1; i < data.length; i++) {
    const area = String(data[i][2] || '').trim();
    if (!area) continue;
    const burn = Number(data[i][5]) || 0; // column F: "Calories Burn"
    burnByArea[area.toLowerCase()] = burn;
  }

  let total = 0;
  for (const sub of subs) {
    if (sub.status !== 'YES') continue;
    const area = String(sub.area || '').trim().toLowerCase();
    if (burnByArea[area] !== undefined) total += burnByArea[area];
  }
  return Math.round(total);
}

/* [32] */ function computeWatchBurn(w) {
  if (!w) return 0;
  // Only steps counted for now — cycling/skipping disabled
  // until accurate data is available.
  return Math.round((Number(w.steps) || 0) * 0.04);
}

/* [33] */ function getWorkoutBurnForDate(dateString) {
  const result = loadTrackerForDate(dateString);
  return computeBurnFromSubs(result.submissions);
}

/* [34] */ function getWatchBurnForDate(dateString) {
  const h = getHealthHabitsForDate(dateString);
  if (!h || !h.watch) return 0;
  return computeWatchBurn(h.watch);
}

/* [35] */ function updateNutritionSummaryFromTracker(dateString, submissions) {
  const trackerBurn = computeBurnFromSubs(submissions);
  const watchBurn   = getWatchBurnForDate(dateString);
  const foodCalories = getFoodCaloriesForDate(dateString);
  updateNutritionSummary(dateString, foodCalories, trackerBurn + watchBurn);
}

/* [36] */ function updateNutritionSummary(dateString, foodCalories, workoutBurn) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('NUTRITION_SUMMARY');

  const HEADER = ['Date','Target','Food Consumed','Food Deficit','Workout Burn','Total Deficit','Status','Watch Burn'];

  if (!sheet) {
    sheet = ss.insertSheet('NUTRITION_SUMMARY');
    sheet.appendRow(HEADER);
    sheet.getRange(1,1,1,HEADER.length).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  } else {
    const headerRow = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 8)).getValues()[0];
    if (String(headerRow[7] || '').trim() !== 'Watch Burn') {
      sheet.getRange(1, 8).setValue('Watch Burn')
        .setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    }
  }

  const target = 2300;
  const data = sheet.getDataRange().getValues();
  let existingRow = -1;
  let watchBurn = 0;

  for (let i = 1; i < data.length; i++) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) {
      existingRow = i + 1;
      watchBurn = Number(data[i][7]) || 0;
      break;
    }
  }

  const finalFood    = Number(foodCalories) || 0;
  const finalWorkout = Number(workoutBurn)  || 0;
  const finalWatch   = Number(watchBurn)    || 0;
  const foodDeficit  = target - finalFood;
  const totalDeficit = foodDeficit + finalWorkout + finalWatch;

  let status = '', color = '';
  if (totalDeficit >= 500) { status = '🔥 ON TRACK'; color = '#4ade80'; }
  else if (totalDeficit > 0) { status = '⚠️ NEED MORE'; color = '#fbbf24'; }
  else { status = '❌ HIGH DEFICIT NEEDED'; color = '#f87171'; }

  const rowVals = [today, target, finalFood, foodDeficit, finalWorkout, totalDeficit, status, finalWatch];

  if (existingRow !== -1) {
    sheet.getRange(existingRow, 1).setNumberFormat('@');
    sheet.getRange(existingRow, 1, 1, 8).setValues([rowVals]);
    sheet.getRange(existingRow, 7).setBackground(color).setFontColor('#0f172a').setFontWeight('bold');
  } else {
    sheet.insertRowAfter(1);
    sheet.getRange(2, 1).setNumberFormat('@');
    sheet.getRange(2, 1, 1, 8).setValues([rowVals]);
    sheet.getRange(2, 7).setBackground(color).setFontColor('#0f172a').setFontWeight('bold');
  }

  try { sortSheetRowsByDateDesc('NUTRITION_SUMMARY', 0); } catch (_) {}
}

/* ═══════════════════════════════════════════════════════════════
   SECTION H — HEALTH HABITS
   ═══════════════════════════════════════════════════════════════ */

/* [37] */ function getHealthHabitsForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('HEALTH_HABITS');
  if (!sheet) return defaultHealthHabits();
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    const c = data[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) {
      return {
        hasRow: true,
        water: { count: Number(data[i][1])  || 0, target: Number(data[i][6])  || 12 },
        break: { count: Number(data[i][2])  || 0, target: Number(data[i][7])  || 15 },
        hair:  { count: Number(data[i][3])  || 0, target: Number(data[i][8])  || 2  },
        face:  { count: Number(data[i][4])  || 0, target: Number(data[i][9])  || 2  },
        teeth: { count: Number(data[i][5])  || 0, target: Number(data[i][10]) || 2  },
        watch: {
          cyclingM: Number(data[i][12]) || 0,
          cyclingE: Number(data[i][13]) || 0,
          skipping: Number(data[i][14]) || 0,
          steps:    Number(data[i][15]) || 0
        }
      };
    }
  }
  return defaultHealthHabits();
}

/* [38] */ function defaultHealthHabits() {
  return {
    hasRow: false,
    water: { count:0, target:12 },
    break: { count:0, target:15 },
    hair:  { count:0, target:2  },
    face:  { count:0, target:2  },
    teeth: { count:0, target:2  },
    watch: { cyclingM:0, cyclingE:0, skipping:0, steps:0 }
  };
}

/* [39] */ function saveMicroHabits(data, dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('HEALTH_HABITS');

  const HEADER = ['Date','WaterCount','BreakCount','HairCount','FaceCount','TeethCount',
                  'WaterTarget','BreakTarget','HairTarget','FaceTarget','TeethTarget','SavedAt',
                  'CyclingM','CyclingE','Skipping','Steps'];

  if (!sheet) {
    sheet = ss.insertSheet('HEALTH_HABITS');
    sheet.appendRow(HEADER);
    sheet.getRange(1,1,1,HEADER.length).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  } else {
    const headerRow = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    if (headerRow.length < HEADER.length || String(headerRow[12] || '').trim() !== 'CyclingM') {
      sheet.getRange(1, 13, 1, 4).setValues([['CyclingM','CyclingE','Skipping','Steps']]);
      sheet.getRange(1, 13, 1, 4).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    }
  }

  const wc = (data.water || {}).count || 0;
  const bc = (data.break || {}).count || 0;
  const hc = (data.hair  || {}).count || 0;
  const fc = (data.face  || {}).count || 0;
  const tc = (data.teeth || {}).count || 0;
  const wt = 12, bt = 15, ht = 2, ft = 2, tt = 2;
  const savedAt = new Date().toISOString();

  const wk = (data.healthLog && data.healthLog.watch) || data.watch || {};
  const cyclingM = Number(wk.cyclingM) || 0;
  const cyclingE = Number(wk.cyclingE) || 0;
  const skipping = Number(wk.skipping) || 0;
  const steps    = Number(wk.steps)    || 0;

  const all = sheet.getDataRange().getValues();
  let row = -1;
  for (let i = 1; i < all.length; i++) {
    const c = all[i][0];
    let cd = '';
    if (c instanceof Date) cd = Utilities.formatDate(c, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else {
      const s = String(c).trim();
      if (/^\d{4}-\d{2}-\d{2}T/.test(s)) {
        const dt = new Date(s);
        if (!isNaN(dt.getTime())) cd = Utilities.formatDate(dt, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      } else cd = s;
    }
    if (cd === today) { row = i + 1; break; }
  }

  const rowVals = [today, wc, bc, hc, fc, tc, wt, bt, ht, ft, tt, savedAt,
                   cyclingM, cyclingE, skipping, steps];

  if (row !== -1) {
    sheet.getRange(row, 1).setNumberFormat('@');
    sheet.getRange(row, 1, 1, rowVals.length).setValues([rowVals]);
  } else {
    const newRow = sheet.getLastRow() + 1;
    sheet.getRange(newRow, 1).setNumberFormat('@');
    sheet.getRange(newRow, 1, 1, rowVals.length).setValues([rowVals]);
  }

  if (data.healthLog && typeof data.healthLog === 'object') {
    let logSheet = ss.getSheetByName('HEALTH_LOG');
    if (!logSheet) {
      logSheet = ss.insertSheet('HEALTH_LOG');
      logSheet.appendRow(['Timestamp','Date','Type','Value','Source']);
      logSheet.getRange(1,1,1,5).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    }
    const ts = new Date().toISOString();
    const rowsToAdd = [];
    ['water','break','hair','face','teeth'].forEach(function (kind) {
      const bucket = data.healthLog[kind] || {};
      const times = bucket.log || [];
      if (times.length) {
        times.forEach(function () {
          rowsToAdd.push([ts, today, kind.toUpperCase(), 1, 'app']);
        });
      } else if ((bucket.count || 0) > 0) {
        rowsToAdd.push([ts, today, kind.toUpperCase(), bucket.count, 'app']);
      }
    });
    if (rowsToAdd.length) {
      logSheet.getRange(logSheet.getLastRow() + 1, 1, rowsToAdd.length, 5).setValues(rowsToAdd);
    }
  }

  try {
    const watchBurn = computeWatchBurn({ cyclingM, cyclingE, skipping, steps });
    const foodCal   = getFoodCaloriesForDate(today);
    const trackerBurn = getWorkoutBurnForDate(today);
    updateNutritionSummary(today, foodCal, trackerBurn + watchBurn);
  } catch (e) {
    Logger.log('saveMicroHabits nutrition update failed: ' + e);
  }

  try { sortSheetRowsByDateDesc('HEALTH_HABITS', 0); } catch (_) {}

  return { water: wc, break: bc, hair: hc, face: fc, teeth: tc,
           cyclingM: cyclingM, cyclingE: cyclingE, skipping: skipping, steps: steps };
}

/* [40] */ function getHealthLogForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  const sheet = ss.getSheetByName('HEALTH_LOG');
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  const out = [];
  for (let i = 1; i < data.length; i++) {
    let d = data[i][1];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(d).trim() === today) {
      out.push({
        timestamp: data[i][0],
        date: d,
        type: data[i][2],
        value: Number(data[i][3]) || 0,
        source: data[i][4] || ''
      });
    }
  }
  return out;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION I — NOTES
   ═══════════════════════════════════════════════════════════════ */

/* [41] */ function getNotesForDate(dateString) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('EVERYDAY_NOTES');
  if (!sheet) return { positive: [], improve: [], common: [], learned: [], office: [] };
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(d).trim() === today) {
      return {
        positive: textToItems(data[i][1]),
        improve:  textToItems(data[i][2]),
        common:   textToItems(data[i][3]),
        learned:  textToItems(data[i][4]),
        office:   textToItems(data[i][5])   // column F — new Office column
      };
    }
  }
  return { positive: [], improve: [], common: [], learned: [], office: [] };
}

/* [42] */ function saveNotes(dateString, notes) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const today = dateToDMY(dateString);
  let sheet = ss.getSheetByName('EVERYDAY_NOTES');

  const HEADER = ['Date','Positive','Improve','Common','Learned','Office','SavedAt'];

  if (!sheet) {
    sheet = ss.insertSheet('EVERYDAY_NOTES');
    sheet.appendRow(HEADER);
    sheet.getRange(1,1,1,HEADER.length).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  } else {
    // ── Migrate: if Office column missing, insert it before SavedAt ──
    const headerRow = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 7)).getValues()[0];
    if (String(headerRow[5] || '').trim() !== 'Office') {
      // Detect whether SavedAt is at column 5 (old layout) or 6 (new)
      if (String(headerRow[5] || '').trim() === 'SavedAt') {
        // Insert a new column before SavedAt
        sheet.insertColumnBefore(6);
        sheet.getRange(1, 6).setValue('Office');
        sheet.getRange(1, 6).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
      } else {
        // Empty column exists at 6 — just label it
        sheet.getRange(1, 6).setValue('Office');
        sheet.getRange(1, 6).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
      }
    }
  }

  function toText(arr) {
    if (!Array.isArray(arr)) return '';
    return arr
      .filter(function (x) { return x && x.text && String(x.text).trim() !== ''; })
      .map(function (x) {
        const s = (x.status === 'done')    ? '✓ ' :
                  (x.status === 'pending') ? '✕ ' :
                  (x.status === 'ignored') ? '⊘ ' : '';
        return s + String(x.text).trim();
      })
      .join('\n');
  }

  const savedAt = new Date().toISOString();
  const row = [
    today,
    toText(notes.positive),
    toText(notes.improve),
    toText(notes.common),
    toText(notes.learned),
    toText(notes.office),
    savedAt
  ];

  const data = sheet.getDataRange().getValues();
  let existing = -1;
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(d).trim() === today) { existing = i + 1; break; }
  }
  if (existing !== -1) {
    sheet.getRange(existing, 1, 1, 7).setValues([row]);
  } else {
    sheet.appendRow(row);
  }
  try { sortSheetRowsByDateDesc('EVERYDAY_NOTES', 0); } catch (_) {}
  return { saved: true };
}

/* [43] */ function getNotesHistory(days) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('EVERYDAY_NOTES');
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  const out = [];
  for (let i = data.length - 1; i >= 1 && out.length < days; i--) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (!d) continue;
    out.push({
      date: String(d),
      positive: textToItems(data[i][1]),
      improve:  textToItems(data[i][2]),
      common:   textToItems(data[i][3]),
      learned:  textToItems(data[i][4]),
      office:   textToItems(data[i][5])
    });
  }
  return out;
}
function DEBUG_notesHistory() {
  const hist = getNotesHistory(7);
  Logger.log('Rows returned: ' + hist.length);
  hist.forEach(function(d, i) {
    const counts = {
      positive: (d.positive || []).length,
      improve:  (d.improve  || []).length,
      common:   (d.common   || []).length,
      learned:  (d.learned  || []).length,
      office:   (d.office   || []).length
    };
    const total = counts.positive + counts.improve + counts.common + counts.learned + counts.office;
    Logger.log('  [' + i + '] ' + d.date + ' — items: ' + total + '  ' + JSON.stringify(counts));
  });
}


/* [44] */ function textToItems(text) {
  if (!text) return [];
  return String(text).split('\n')
    .map(function (line) { return line.trim(); })
    .filter(function (line) { return line !== ''; })
    .map(function (line, idx) {
      let status = '';
      let body = line;
      if (line.indexOf('✓ ') === 0)      { status = 'done';    body = line.slice(2); }
      else if (line.indexOf('✕ ') === 0) { status = 'pending'; body = line.slice(2); }
      else if (line.indexOf('⊘ ') === 0) { status = 'ignored'; body = line.slice(2); }
      return {
        id: 'n' + Date.now() + '_' + idx,
        text: body.trim(),
        status: status
      };
    });
}

/* ═══════════════════════════════════════════════════════════════
   SECTION J — CALENDAR ITEMS
   ═══════════════════════════════════════════════════════════════ */

/* [45] */ function getCalendarItems() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('CALENDAR_ITEMS');
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  const out = [];
  for (let i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    out.push({
      id: data[i][0],
      type: data[i][1],
      date: normalizeDateForOutput(data[i][2]),
      time: (function (v) {
        if (v === '' || v === null || v === undefined) return '';
        if (typeof v === 'number') {
          const h = Math.floor(v);
          const m = Math.round((v - h) * 60);
          return String(h).padStart(2,'0') + '.' + String(m).padStart(2,'0');
        }
        return String(v);
      })(data[i][3]),
      month: Number(data[i][4]) || 0,
      day: Number(data[i][5]) || 0,
      title: data[i][6] || '',
      notes: data[i][7] || '',
      remindMin: Number(data[i][8]) || 15,
      status: data[i][9] || '',
      lastYear: Number(data[i][10]) || 0,
      eventId: data[i][11] || ''
    });
  }
  return out;
}

/* [46] */ function saveCalendarItems(items) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('CALENDAR_ITEMS');
  if (!sheet) {
    sheet = ss.insertSheet('CALENDAR_ITEMS');
    sheet.appendRow(['ID','Type','Date','Time','Month','Day','Title','Notes','RemindMin','Status','LastYear','EventId','UpdatedAt']);
    sheet.getRange(1,1,1,13).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  const existingEventIds = {};
  const preData = sheet.getDataRange().getValues();
  for (let i = 1; i < preData.length; i++) {
    const rid  = String(preData[i][0]  || '').trim();
    const evid = String(preData[i][11] || '').trim();
    if (rid && evid) existingEventIds[rid] = evid;
  }

  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).clearContent();
  }

  const updatedAt = new Date().toISOString();
  const rows = items.map(function (it) {
    return [
      it.id || '',
      it.type || 'reminder',
      "'" + (it.date || ''),
      it.time || '',
      it.month || '',
      it.day || '',
      it.title || '',
      it.notes || '',
      it.remindMin || 15,
      it.status || '',
      it.lastYear || 0,
      it.eventId || existingEventIds[it.id] || '',
      updatedAt
    ];
  });
  if (rows.length) {
    sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);
  }
  try { remSyncAllToCalendar(); } catch (e) { Logger.log('remSyncAllToCalendar failed: ' + e); }
  return { count: rows.length };
}

/* ═══════════════════════════════════════════════════════════════
   SECTION K — ROUTINE → GOOGLE CALENDAR
   ═══════════════════════════════════════════════════════════════ */

const ROUTINE_CAL_NAME = 'LifeOS Routine';
const ROUTINE_LEAD_MIN = 2;

/* [47] */ function getOrCreateRoutineCalendar() {
  const list = CalendarApp.getCalendarsByName(ROUTINE_CAL_NAME);
  if (list && list.length) return list[0];
  return CalendarApp.createCalendar(ROUTINE_CAL_NAME, {
    summary: 'LifeOS routine tasks',
    color: CalendarApp.Color.BLUE,
    timeZone: Session.getScriptTimeZone()
  });
}

/* [48] */ function syncRoutineForDate(dateString) {
  const cal = getOrCreateRoutineCalendar();
  const parsed = parseDMY(dateString);
  if (!parsed) return { created:0, updated:0, deleted:0, unchanged:0 };

  const y = parsed[0];
  const m = parsed[1];
  const d = parsed[2];

  const dayStart = new Date(y, m, d, 0, 0, 0);
  const dayEnd   = new Date(y, m, d, 23, 59, 59);

  const existing = cal.getEvents(dayStart, dayEnd);
  const byTitle = {};
  existing.forEach(function (ev) {
    const t = ev.getTitle();
    if (!byTitle[t]) byTitle[t] = [];
    byTitle[t].push(ev);
  });

  const tasks = getTasksForDate(dateString);
  const expected = {};
  let created = 0, updated = 0, deleted = 0, unchanged = 0;

  const now = new Date();
  const isToday = (y === now.getFullYear() && m === now.getMonth() && d === now.getDate());

  tasks.forEach(function (t) {
    const r = parseTimeRange(t.plannedTime);
    if (!r) return;
    expected[t.area] = true;

    const sH = r.startH, sM = r.startM;
    const eH = r.endH,   eM = r.endM;

    let start = new Date(y, m, d, sH, sM, 0);
    let end;
    if (eH < sH || (eH === sH && eM <= sM)) {
      end = new Date(y, m, d, 23, 59, 0);
    } else {
      end = new Date(y, m, d, eH, eM, 0);
    }

    // ── Skip already-ended tasks on today to prevent the recreate/delete loop
    if (isToday && end.getTime() < now.getTime()) {
      const stale = byTitle[t.area] || [];
      stale.forEach(function (ev) { try { ev.deleteEvent(); deleted++; } catch (_) {} });
      expected[t.area] = false;
      return;
    }

    const matches = byTitle[t.area] || [];

    if (matches.length === 0) {
      try {
        const ev = cal.createEvent(t.area, start, end, {
          description: (t.head || '') + ' › ' + (t.subCategory || '')
        });
        try { ev.removeAllReminders(); } catch (_) {}
        try { ev.addPopupReminder(ROUTINE_LEAD_MIN); } catch (_) {}
        created++;
      } catch (err) { Logger.log('create fail: ' + t.area + ' — ' + err); }
      return;
    }

    const ev = matches[0];
    const sameStart = Math.abs(ev.getStartTime().getTime() - start.getTime()) < 60000;
    const sameEnd   = Math.abs(ev.getEndTime().getTime()   - end.getTime())   < 60000;

    if (sameStart && sameEnd) {
      unchanged++;
    } else {
      try {
        ev.setTime(start, end);
        try { ev.removeAllReminders(); } catch (_) {}
        try { ev.addPopupReminder(ROUTINE_LEAD_MIN); } catch (_) {}
        updated++;
      } catch (err) { Logger.log('update fail: ' + t.area + ' — ' + err); }
    }

    for (let i = 1; i < matches.length; i++) {
      try { matches[i].deleteEvent(); } catch (_) {}
    }
  });

  Object.keys(byTitle).forEach(function (title) {
    if (expected[title]) return;
    byTitle[title].forEach(function (ev) {
      try { ev.deleteEvent(); deleted++; } catch (_) {}
    });
  });

  Logger.log(dateString + ' → +' + created + ' ~' + updated + ' -' + deleted + ' =' + unchanged);
  return { created, updated, deleted, unchanged };
}

/* [49] */ function syncRoutineTwoDays() {
  const tz = Session.getScriptTimeZone();
  const totals = { created: 0, updated: 0, deleted: 0, unchanged: 0 };

  for (let offset = 0; offset <= 1; offset++) {
    const d = new Date();
    d.setDate(d.getDate() + offset);
    const dm = Utilities.formatDate(d, tz, 'dd-MMM-yyyy');
    try {
      const r = syncRoutineForDate(dm);
      totals.created   += r.created;
      totals.updated   += r.updated;
      totals.deleted   += r.deleted;
      totals.unchanged += r.unchanged;
    } catch (e) {
      Logger.log('sync error for ' + dm + ': ' + e);
    }
  }

  Logger.log('Two-day sync: ' + JSON.stringify(totals));
  return totals;
}

/* [50] */ function cleanPastRoutineEvents() {
  const cal = getOrCreateRoutineCalendar();
  const now = new Date();

  const from = new Date(now.getTime() - 3 * 24 * 60 * 60 * 1000);
  from.setHours(0, 0, 0, 0);

  const candidates = cal.getEvents(from, now);

  let deleted = 0;
  candidates.forEach(function (ev) {
    const end = ev.getEndTime();
    if (end && end.getTime() < now.getTime()) {
      try { ev.deleteEvent(); deleted++; } catch (_) {}
    }
  });

  Logger.log('routine cleanup: candidates=' + candidates.length + ' deleted=' + deleted);
  return deleted;
}

/* [50b] Past events vanish automatically — delete ALL past events
   from every LifeOS calendar older than 'now'. Call this on a
   time-driven trigger (every 15 min) so stale events disappear
   without user action. */
function cleanAllPastEvents() {
  const cals = []
    .concat(CalendarApp.getCalendarsByName('LifeOS'))
    .concat(CalendarApp.getCalendarsByName('LifeOS Routine'))
    .concat(CalendarApp.getCalendarsByName('LifeOS Health'))
    .concat(CalendarApp.getCalendarsByName('LifeOS Wishes'));

  const now = new Date();
  const from = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);  // look back 7 days
  let deleted = 0;

  cals.forEach(function (cal) {
    try {
      const evs = cal.getEvents(from, now);
      evs.forEach(function (ev) {
        const end = ev.getEndTime();
        if (end && end.getTime() < now.getTime()) {
          try { ev.deleteEvent(); deleted++; } catch (_) {}
        }
      });
    } catch (e) {
      Logger.log('cleanAllPastEvents failed on ' + cal.getName() + ': ' + e);
    }
  });

  Logger.log('cleanAllPastEvents: deleted=' + deleted);
  return { deleted: deleted };
}

/* ═══════════════════════════════════════════════════════════════
   SECTION L — HEALTH → GOOGLE CALENDAR (RECURRING)
   ═══════════════════════════════════════════════════════════════ */

const HEALTH_CAL_NAME = 'LifeOS Health';

const HEALTH_SCHEDULE = {
  water: {
    title: '💧 Drink Water (100 ml)',
    startHour: 9, endHour: 18, everyMin: 20, durationMin: 5, leadMin: 2
  },
  break: {
    title: '🌿 5-min Break',
    startHour: 9, endHour: 18, everyMin: 60, durationMin: 5, leadMin: 2
  }
};

/* [51] */ function getOrCreateHealthCalendar() {
  const list = CalendarApp.getCalendarsByName(HEALTH_CAL_NAME);
  if (list && list.length) return list[0];
  return CalendarApp.createCalendar(HEALTH_CAL_NAME, {
    summary: 'LifeOS health reminders (water + breaks)',
    color: CalendarApp.Color.GREEN,
    timeZone: Session.getScriptTimeZone()
  });
}

/* [52] */ function syncHealthForDate(dateString) {
  const cal = getOrCreateHealthCalendar();
  const parsed = parseDMY(dateString);
  if (!parsed) return { created: 0, deleted: 0, unchanged: 0 };

  const y = parsed[0], m = parsed[1], d = parsed[2];

  const now = new Date();
  const isToday = (y === now.getFullYear() && m === now.getMonth() && d === now.getDate());

  const dayStart = new Date(y, m, d, 0, 0, 0);
  const dayEnd   = new Date(y, m, d, 23, 59, 59);
  const existing = cal.getEvents(dayStart, dayEnd);

  // Index existing events by title + start time
  const byKey = {};
  existing.forEach(function (ev) {
    const key = ev.getTitle() + '|' + ev.getStartTime().getTime();
    byKey[key] = ev;
  });

  let created = 0, unchanged = 0;
  const expected = {};

  const keys = Object.keys(HEALTH_SCHEDULE);
  for (let k = 0; k < keys.length; k++) {
    const sched = HEALTH_SCHEDULE[keys[k]];

    for (let h = sched.startHour; h <= sched.endHour; h++) {
      for (let min = 0; min < 60; min += sched.everyMin) {
        if (h === sched.endHour && min > 0) break;

        const start = new Date(y, m, d, h, min, 0);
        const end   = new Date(start.getTime() + sched.durationMin * 60 * 1000);

        // ── KEY FIX: skip past events on today ──
        if (isToday && end.getTime() < now.getTime()) {
          const staleKey = sched.title + '|' + start.getTime();
          if (byKey[staleKey]) {
            try { byKey[staleKey].deleteEvent(); } catch (_) {}
          }
          continue;
        }

        const dedupeKey = sched.title + '|' + start.getTime();
        expected[dedupeKey] = true;

        if (byKey[dedupeKey]) {
          unchanged++;
          continue;
        }

        if (created > 0) Utilities.sleep(300);

        try {
          const ev = cal.createEvent(sched.title, start, end, {
            description: 'Auto reminder from LifeOS'
          });
          try { ev.removeAllReminders(); } catch (_) {}
          try { ev.addPopupReminder(sched.leadMin); } catch (_) {}
          created++;
        } catch (err) {
          Logger.log('health create fail: ' + sched.title + ' @ ' + start + ' — ' + err);
        }
      }
    }
  }

  // Delete stray past events (if any remained from old runs)
  let deleted = 0;
  existing.forEach(function (ev) {
    const key = ev.getTitle() + '|' + ev.getStartTime().getTime();
    if (!expected[key]) {
      const end = ev.getEndTime();
      if (end && end.getTime() < now.getTime()) {
        try { ev.deleteEvent(); deleted++; } catch (_) {}
      }
    }
  });

  Logger.log(dateString + ' health → +' + created + ' -' + deleted + ' =' + unchanged);
  return { created, deleted, unchanged };
}

/* [53] */ function syncHealthTwoDays() {
  const tz = Session.getScriptTimeZone();
  const totals = { created: 0, deleted: 0, unchanged: 0 };

  for (let offset = 0; offset <= 1; offset++) {
    const d = new Date();
    d.setDate(d.getDate() + offset);
    const dm = Utilities.formatDate(d, tz, 'dd-MMM-yyyy');
    try {
      const r = syncHealthForDate(dm);
      totals.created   += r.created;
      totals.deleted   += r.deleted;
      totals.unchanged += r.unchanged;
    } catch (e) {
      Logger.log('health sync error for ' + dm + ': ' + e);
    }
    if (offset === 0) Utilities.sleep(2000);
  }

  Logger.log('Health two-day sync: ' + JSON.stringify(totals));
  return totals;
}

/* [54] */ function cleanPastHealthEvents() {
