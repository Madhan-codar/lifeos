/* ═══════════════════════════════════════════════════════════════
   SECTION M — WISHES → GOOGLE CALENDAR
   ═══════════════════════════════════════════════════════════════ */

const WISHES_CAL_NAME = 'LifeOS Wishes';

/* [55] */ function getOrCreateWishesCalendar() {
  const list = CalendarApp.getCalendarsByName(WISHES_CAL_NAME);
  if (list && list.length) return list[0];
  return CalendarApp.createCalendar(WISHES_CAL_NAME, {
    summary: 'LifeOS birthdays and anniversaries',
    color: CalendarApp.Color.PINK,
    timeZone: Session.getScriptTimeZone()
  });
}

/* [56] */ function createEventForReminder(it) {
  try {
    const isReminder = it.type === 'reminder';
    const cal = isReminder
      ? (CalendarApp.getCalendarsByName('LifeOS')[0] || CalendarApp.getDefaultCalendar())
      : getOrCreateWishesCalendar();

    let start, end;

    if (isReminder) {
      const normalizedDate = normalizeDateForOutput(it.date);
      const parsed = parseDMY(normalizedDate);
      if (!parsed) { Logger.log('bad date for reminder: ' + it.date); return null; }
      const t = parseRemTime(it.time);
      start = new Date(parsed[0], parsed[1], parsed[2], t.h, t.m, 0);
      end   = new Date(start.getTime() + 30 * 60 * 1000);
    } else {
      const now = new Date();
      const month = Number(it.month) - 1;
      const day   = Number(it.day);
      if (isNaN(month) || isNaN(day)) { Logger.log('bad wish date'); return null; }
      start = new Date(now.getFullYear(), month, day, 0, 0, 0);
      end   = new Date(now.getFullYear(), month, day + 1, 0, 0, 0);
    }

    const title = (it.type === 'birthday' ? '🎂 ' :
                   it.type === 'anniversary' ? '💍 ' :
                   '🔔 ') + (it.title || 'Untitled');

    const searchStart = new Date(start.getTime() - 60 * 1000);
    const searchEnd   = new Date(end.getTime()   + 60 * 1000);
    let existing = null;
    try {
      const candidates = cal.getEvents(searchStart, searchEnd);
      for (let i = 0; i < candidates.length; i++) {
        const c = candidates[i];
        if (c.getTitle() !== title) continue;
        const cStart = c.getStartTime().getTime();
        if (Math.abs(cStart - start.getTime()) < 60 * 1000) { existing = c; break; }
      }
    } catch (_) {}

    if (existing) {
      try { existing.removeAllReminders(); } catch (_) {}
      if (isReminder) {
        try { existing.addPopupReminder(Number(it.remindMin) || 15); } catch (_) {}
      } else {
        try { existing.addPopupReminder(1440); } catch (_) {}
      }
      return existing.getId();
    }

    const ev = isReminder
      ? cal.createEvent(title, start, end, { description: it.notes || '' })
      : cal.createAllDayEvent(title, start, { description: it.notes || '' });

    try { ev.removeAllReminders(); } catch (_) {}
    if (isReminder) {
      try { ev.addPopupReminder(Number(it.remindMin) || 15); } catch (_) {}
    } else {
      try { ev.addPopupReminder(1440); } catch (_) {}
    }

    return ev.getId();
  } catch (e) {
    Logger.log('createEventForReminder failed: ' + e);
    return null;
  }
}

/* [57] */ function deleteEventById(eventId) {
  if (!eventId) return false;
  const calNames = ['LifeOS', 'LifeOS Wishes', 'LifeOS Health', 'LifeOS Routine'];
  for (let i = 0; i < calNames.length; i++) {
    try {
      const list = CalendarApp.getCalendarsByName(calNames[i]);
      if (!list || !list.length) continue;
      const ev = list[0].getEventById(eventId);
      if (ev) { ev.deleteEvent(); return true; }
    } catch (_) {}
  }
  return false;
}

/* [58] */ function updateEventForReminder(oldEventId, it) {
  if (oldEventId) { try { deleteEventById(oldEventId); } catch (_) {} }
  return createEventForReminder(it);
}

/* [59] remSyncAllToCalendar — now delegates to the 5-slot engine */
function remSyncAllToCalendar() {
  try {
    return reminderSyncAll();
  } catch (e) {
    Logger.log('remSyncAllToCalendar error: ' + e);
    return { status: 'error', message: String(e) };
  }
}

/* ═══════════════════════════════════════════════════════════════
   SECTION N0 — 5-SLOT REMINDER SCHEDULE (shared)
   Every item — reminder, birthday, anniversary, countdown —
   gets 5 Google Calendar events:
     1) 2 days before  @ 09.15 – 09.20
     2) 1 day  before  @ 09.15 – 09.20
     3) event day      @ 07.05 – 07.10
     4) event day      @ 10.15 – 10.20
     5) event day      @ 15.15 – 15.20
   Each event has a 2-min-before popup. Past slots are auto-deleted
   by cleanAllPastEvents() (15-min trigger).
   ═══════════════════════════════════════════════════════════════ */

const SLOT_DEFS = [
  { n: 1, offsetDays: -2, start: '09.15', end: '09.20', label: '2 days before' },
  { n: 2, offsetDays: -1, start: '09.15', end: '09.20', label: '1 day before'  },
  { n: 3, offsetDays:  0, start: '07.05', end: '07.10', label: 'Morning'       },
  { n: 4, offsetDays:  0, start: '10.15', end: '10.20', label: 'Late morning'  },
  { n: 5, offsetDays:  0, start: '15.15', end: '15.20', label: 'Afternoon'     }
];

/* Parse "09.15" → {h:9, m:15} */
function parseDotTime(s) {
  const p = String(s || '').split('.');
  return { h: parseInt(p[0], 10) || 0, m: parseInt(p[1] || '0', 10) || 0 };
}

/* Build a Date for (baseY, baseM0, baseD) + offsetDays at HH.MM */
function slotDate(baseY, baseM0, baseD, offsetDays, dotTime) {
  const t = parseDotTime(dotTime);
  return new Date(baseY, baseM0, baseD + offsetDays, t.h, t.m, 0, 0);
}

/* Get or create the primary LifeOS calendar */
function getOrCreateLifeOSCalendar() {
  const named = CalendarApp.getCalendarsByName('LifeOS');
  if (named && named.length) return named[0];
  try {
    return CalendarApp.createCalendar('LifeOS', {
      summary: 'LifeOS reminders',
      timeZone: Session.getScriptTimeZone()
    });
  } catch (e) {
    return CalendarApp.getDefaultCalendar();
  }
}

/* Title prefix by item kind */
function slotEmoji(kind) {
  if (kind === 'birthday')    return '🎂';
  if (kind === 'anniversary') return '💍';
  if (kind === 'countdown')   return '🔥';
  return '🔔';
}

/* Compose event title for a slot */
function slotTitle(kind, title, slot) {
  const em = slotEmoji(kind);
  return em + ' ' + slot.label + ': ' + title;
}

/* Delete events matching this title in the window [from, to] on the given calendar. */
function deleteEventsByTitle(cal, title, from, to) {
  let n = 0;
  try {
    const evs = cal.getEvents(from, to);
    evs.forEach(function (ev) {
      if (ev.getTitle() === title) {
        try { ev.deleteEvent(); n++; } catch (_) {}
      }
    });
  } catch (_) {}
  return n;
}

/* Core: ensure the 5 slots exist for one item.
   item = { kind, title, dateY, dateM0, dateD, notes, sourceId } */
function ensureFiveSlots(item) {
  const cal = getOrCreateLifeOSCalendar();
  const y = item.dateY, m0 = item.dateM0, d = item.dateD;
  const created = [];
  const skipped = [];

  SLOT_DEFS.forEach(function (slot) {
    const start = slotDate(y, m0, d, slot.offsetDays, slot.start);
    const end   = slotDate(y, m0, d, slot.offsetDays, slot.end);
    const title = slotTitle(item.kind, item.title, slot);

    // Skip if it's in the past
    if (end.getTime() < Date.now()) { skipped.push(slot.n); return; }

    // Dedupe window: ±1 hour around start
    const from = new Date(start.getTime() - 3600000);
    const to   = new Date(end.getTime()   + 3600000);
    let exists = false;
    try {
      const evs = cal.getEvents(from, to);
      for (let i = 0; i < evs.length; i++) {
        if (evs[i].getTitle() === title) {
          const s = evs[i].getStartTime().getTime();
          if (Math.abs(s - start.getTime()) < 60000) { exists = true; break; }
        }
      }
    } catch (_) {}

    if (exists) { skipped.push(slot.n); return; }

    try {
      const ev = cal.createEvent(title, start, end, {
        description: item.notes || ('Auto reminder · ' + item.kind)
      });
      try { ev.removeAllReminders(); } catch (_) {}
      try { ev.addPopupReminder(2); } catch (_) {}
      created.push(slot.n);
    } catch (err) {
      Logger.log('ensureFiveSlots create fail ' + title + ' → ' + err);
    }
  });

  return { created: created, skipped: skipped };
}

/* Delete all 5 slots for one item */
function deleteFiveSlots(kind, title, y, m0, d) {
  const cal = getOrCreateLifeOSCalendar();
  let removed = 0;
  SLOT_DEFS.forEach(function (slot) {
    const start = slotDate(y, m0, d, slot.offsetDays, slot.start);
    const end   = slotDate(y, m0, d, slot.offsetDays, slot.end);
    const titleStr = slotTitle(kind, title, slot);
    const from = new Date(start.getTime() - 3600000);
    const to   = new Date(end.getTime()   + 3600000);
    removed += deleteEventsByTitle(cal, titleStr, from, to);
  });
  return removed;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION N — COUNTDOWNS
   ═══════════════════════════════════════════════════════════════ */

/* [60] */ function getCountdownsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('COUNTDOWNS');
  if (!sheet) {
    sheet = ss.insertSheet('COUNTDOWNS');
    sheet.appendRow(['ID','Emoji','Title','Deadline','Notes','Status','CreatedAt','UpdatedAt']);
    sheet.getRange(1,1,1,8).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
}

/* [61] */ function countdownLoad() {
  const sheet = getCountdownsSheet();
  const data = sheet.getDataRange().getValues();
  const items = [];
  for (let i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    items.push({
      id: data[i][0],
      emoji: data[i][1] || '🎯',
      title: data[i][2] || '',
      deadline: data[i][3] || '',
      notes: data[i][4] || '',
      status: data[i][5] || ''
    });
  }
  return { status: 'success', items: items };
}

/* [62] */ function countdownSave(data) {
  const sheet = getCountdownsSheet();
  const now = new Date().toISOString();

  if (data.id) {
    const values = sheet.getDataRange().getValues();
    for (let i = 1; i < values.length; i++) {
      if (String(values[i][0]) === String(data.id)) {
        sheet.getRange(i+1, 3).setValue(data.title || '');
        sheet.getRange(i+1, 4).setValue(data.deadline || '');
        sheet.getRange(i+1, 5).setValue(data.notes || '');
        sheet.getRange(i+1, 8).setValue(now);
        try { countdownSyncAllReminders(); } catch (_) {}
        return { status: 'success' };
      }
    }
    return { status: 'error', message: 'countdown not found' };
  }

  const id = 'c' + Date.now() + Math.random().toString(36).slice(2,5);
  sheet.appendRow([id, '', data.title || '', data.deadline || '', data.notes || '', '', now, now]);
  try { countdownSyncAllReminders(); } catch (_) {}
  return { status: 'success', id: id };
}

/* [63] */ function countdownDelete(id) {
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getCountdownsSheet();
  const data = sheet.getDataRange().getValues();
  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][0]) === String(id)) { sheet.deleteRow(i+1); break; }
  }
  try { countdownSyncAllReminders(); } catch (_) {}
  return { status: 'success' };
}

/* [64] */ function countdownStatus(id, status) {
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getCountdownsSheet();
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(id)) {
      sheet.getRange(i+1, 6).setValue(status || '');
      sheet.getRange(i+1, 8).setValue(new Date().toISOString());
      return { status: 'success' };
    }
  }
  return { status: 'error', message: 'not found' };
}

/* [65] */ function countdownCreateReminders(data) {
  return countdownSyncAllReminders();
}

/* [66] */ function reminderIdFor(countdownId, slot) {
  return 'cdrem_' + countdownId + '_' + slot;
}

/* Legacy helper — kept for compatibility, no longer used by sync */
function reminderTitleFor(slot, countdownTitle) {
  if (slot === 1) return '⏰ Tomorrow is deadline: ' + countdownTitle;
  if (slot === 2) return '🔔 Deadline today: ' + countdownTitle;
  return '🔥 Deadline today (final): ' + countdownTitle;
}

/* Delete any legacy 3-slot countdown events (old titles) */
function purgeLegacyCountdownEvents() {
  const cal = getOrCreateLifeOSCalendar();
  const now = new Date();
  const from = new Date(now.getFullYear() - 1, 0, 1);
  const to   = new Date(now.getFullYear() + 2, 0, 1);
  const prefixes = [
    '⏰ Tomorrow is deadline:',
    '🔔 Deadline today:',
    '🔥 Deadline today (final):'
  ];
  let deleted = 0;
  try {
    const evs = cal.getEvents(from, to);
    evs.forEach(function (ev) {
      const t = ev.getTitle();
      for (let i = 0; i < prefixes.length; i++) {
        if (t.indexOf(prefixes[i]) === 0) {
          try { ev.deleteEvent(); deleted++; } catch (_) {}
          break;
        }
      }
    });
  } catch (e) { Logger.log('purgeLegacy: ' + e); }
  return deleted;
}

/* [68] countdownSyncAllReminders — NEW 5-slot version */
function countdownSyncAllReminders() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const cdSheet = ss.getSheetByName('COUNTDOWNS');
  if (!cdSheet) return { status: 'error', message: 'no countdowns sheet' };

  // One-time purge of old 3-slot titles
  try { purgeLegacyCountdownEvents(); } catch (_) {}

  const cdData = cdSheet.getDataRange().getValues();
  const countdowns = [];
  for (let i = 1; i < cdData.length; i++) {
    const id = cdData[i][0];
    if (!id) continue;
    const title = String(cdData[i][2] || '').trim();
    const deadline = cdData[i][3];
    if (!title || !deadline) continue;
    countdowns.push({ id: String(id), title: title, deadline: deadline });
  }

  // Build list of expected slot-titles for all countdowns
  const allCountdownTitles = {};
  const createdIds = [];
  let totalCreated = 0, totalSkipped = 0;

  countdowns.forEach(function (cd) {
    const parsed = parseCountdownDMY(cd.deadline);
    if (!parsed) return;
    allCountdownTitles[cd.title] = true;
    const r = ensureFiveSlots({
      kind: 'countdown',
      title: cd.title,
      dateY: parsed.y, dateM0: parsed.m0, dateD: parsed.d,
      notes: 'Auto reminder · countdown: ' + cd.title
    });
    totalCreated += (r.created || []).length;
    totalSkipped += (r.skipped || []).length;
  });

  // Clean stale countdown slots: any event with 🔥 prefix whose title isn't in allCountdownTitles
  const cal = getOrCreateLifeOSCalendar();
  const now = new Date();
  const from = new Date(now.getFullYear() - 1, 0, 1);
  const to   = new Date(now.getFullYear() + 2, 0, 1);
  let deletedEvents = 0;
  try {
    const evs = cal.getEvents(from, to);
    evs.forEach(function (ev) {
      const t = ev.getTitle();
      if (t.indexOf('🔥 ') !== 0) return;
      // extract countdown title from "🔥 <label>: <title>"
      const idx = t.indexOf(': ');
      if (idx === -1) return;
      const ct = t.slice(idx + 2).trim();
      if (!allCountdownTitles[ct]) {
        try { ev.deleteEvent(); deletedEvents++; } catch (_) {}
      }
    });
  } catch (_) {}

  return {
    status: 'success',
    countdowns: countdowns.length,
    eventsCreated: totalCreated,
    eventsSkipped: totalSkipped,
    eventsDeleted: deletedEvents
  };
}

/* ═══════════════════════════════════════════════════════════════
   WISHES / REMINDERS — 5-slot sync
   ═══════════════════════════════════════════════════════════════ */

/* Sync all CALENDAR_ITEMS rows through ensureFiveSlots */
function calendarItemsSyncAllReminders() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('CALENDAR_ITEMS');
  if (!sheet) return { status: 'error', message: 'no CALENDAR_ITEMS' };

  const data = sheet.getDataRange().getValues();
  let totalCreated = 0, totalSkipped = 0;
  const expected = {};

  for (let i = 1; i < data.length; i++) {
    const id    = String(data[i][0] || '').trim();
    if (!id) continue;
    if (id.indexOf('cdrem_') === 0) continue; // skip countdown row-artifacts

    const type  = String(data[i][1] || 'reminder').trim();
    let   dateV = data[i][2];
    const month = Number(data[i][4]) || 0;
    const day   = Number(data[i][5]) || 0;
    const title = String(data[i][6] || '').trim();
    const notes = String(data[i][7] || '').trim();
    if (!title) continue;

    let y, m0, d;

    if (type === 'reminder') {
      const parsed = parseCountdownDMY(dateV);
      if (!parsed) continue;
      y = parsed.y; m0 = parsed.m0; d = parsed.d;
    } else {
      // birthday / anniversary → use this year's occurrence (or next year's if already past)
      if (!month || !day) continue;
      m0 = month - 1;
      d  = day;
      const now = new Date();
      y = now.getFullYear();
      // If this year's date already fully passed, roll to next year
      const thisYearDate = new Date(y, m0, d);
      const oneDayAfter = new Date(y, m0, d + 1);
      if (oneDayAfter.getTime() < now.getTime()) {
        y = y + 1;
      }
    }

    const key = type + '|' + title + '|' + y + '-' + (m0 + 1) + '-' + d;
    expected[key] = true;

    const r = ensureFiveSlots({
      kind: type,
      title: title,
      dateY: y, dateM0: m0, dateD: d,
      notes: notes || ('Auto reminder · ' + type)
    });
    totalCreated += (r.created || []).length;
    totalSkipped += (r.skipped || []).length;
  }

  // Clean stale wish/reminder slots: any event whose emoji prefix says
  // it's ours, but whose (kind,title,date) is no longer expected.
  const cal = getOrCreateLifeOSCalendar();
  const now = new Date();
  const from = new Date(now.getFullYear() - 1, 0, 1);
  const to   = new Date(now.getFullYear() + 3, 0, 1);
  const prefixes = ['🔔 ', '🎂 ', '💍 '];
  const slotLabels = SLOT_DEFS.map(function (s) { return s.label; });

  let deletedEvents = 0;
  try {
    const evs = cal.getEvents(from, to);
    evs.forEach(function (ev) {
      const t = ev.getTitle();
      let matchedPrefix = null;
      for (let i = 0; i < prefixes.length; i++) {
        if (t.indexOf(prefixes[i]) === 0) { matchedPrefix = prefixes[i]; break; }
      }
      if (!matchedPrefix) return;

      // Format: "<emoji> <label>: <title>"
      const afterEmoji = t.slice(matchedPrefix.length);
      const colonIdx = afterEmoji.indexOf(': ');
      if (colonIdx === -1) return;
      const label = afterEmoji.slice(0, colonIdx).trim();
      const titleStr = afterEmoji.slice(colonIdx + 2).trim();
      if (slotLabels.indexOf(label) === -1) return;

      const kind = matchedPrefix === '🎂 ' ? 'birthday'
                 : matchedPrefix === '💍 ' ? 'anniversary'
                 : 'reminder';

      // Was it in our expected set? We keyed by year, but the event itself
      // carries a specific date — reconstruct the y-m-d from event start.
      const st = ev.getStartTime();
      const ymd = st.getFullYear() + '-' + (st.getMonth() + 1) + '-' + st.getDate();
      // Find whether any expected key matches this title + approximate year
      // (year-of-event may differ from year-of-event-date by up to 2 days
      //  because slot 1 fires 2 days earlier; allow both).
      const evY = st.getFullYear();
      let found = false;
      for (let yy = evY - 1; yy <= evY + 1 && !found; yy++) {
        const k = kind + '|' + titleStr + '|' + yy + '-' + (m0FromEvent(st) + 1) + '-' + dFromEvent(st);
        if (expected[k]) { found = true; break; }
      }
      // Simpler fallback: check any key with this exact kind + title
      if (!found) {
        for (const k in expected) {
          if (k.indexOf(kind + '|' + titleStr + '|') === 0) { found = true; break; }
        }
      }

      if (!found) {
        try { ev.deleteEvent(); deletedEvents++; } catch (_) {}
      }
    });
  } catch (e) { Logger.log('wish cleanup: ' + e); }

  return {
    status: 'success',
    eventsCreated: totalCreated,
    eventsSkipped: totalSkipped,
    eventsDeleted: deletedEvents
  };
}

function m0FromEvent(d) { return d.getMonth(); }
function dFromEvent(d)  { return d.getDate(); }

/* One button: sync everything (countdowns + calendar items) */
function reminderSyncAll() {
  const a = countdownSyncAllReminders();
  const b = calendarItemsSyncAllReminders();
  const result = {
    status: 'success',
    countdowns: a,
    calendarItems: b
  };
  Logger.log('reminderSyncAll: ' + JSON.stringify(result));
  return result;
}

