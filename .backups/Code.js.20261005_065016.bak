/* [90] */ function getTimeSkipsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('TIME_SKIPS');
  if (!sheet) {
    sheet = ss.insertSheet('TIME_SKIPS');
    sheet.appendRow(['ID','Date','FromTime','ToTime','Title','Notes','CreatedAt']);
    sheet.getRange(1,1,1,7).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }
  return sheet;
}

/* [91] */ function timeSkipsLoad() {
  const sheet = getTimeSkipsSheet();
  const data = sheet.getDataRange().getValues();
  const out = [];
  for (let i = 1; i < data.length; i++) {
    if (!data[i][0]) continue;
    let d = data[i][1];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    out.push({
      id: data[i][0],
      date: String(d || ''),
      from: data[i][2] || '',
      to: data[i][3] || '',
      title: data[i][4] || '',
      notes: data[i][5] || ''
    });
  }
  return { status: 'success', items: out };
}

/* [92] */ function timeSkipSave(data) {
  const sheet = getTimeSkipsSheet();
  const now = new Date().toISOString();

  const from  = String(data.from || '').trim();
  const to    = String(data.to   || '').trim();
  const date  = String(data.date || '').trim();
  const title = String(data.title || '').trim();

  if (!date)  return { status: 'error', message: 'date required' };
  if (!from)  return { status: 'error', message: 'from time required' };
  if (!to)    return { status: 'error', message: 'to time required' };
  if (!title) return { status: 'error', message: 'title required' };

  let savedId = data.id;

  if (data.id) {
    const values = sheet.getDataRange().getValues();
    let found = false;
    for (let i = 1; i < values.length; i++) {
      if (String(values[i][0]) === String(data.id)) {
        sheet.getRange(i+1, 2).setValue("'" + date);
        sheet.getRange(i+1, 3).setValue(from);
        sheet.getRange(i+1, 4).setValue(to);
        sheet.getRange(i+1, 5).setValue(title);
        sheet.getRange(i+1, 6).setValue(data.notes || '');
        found = true;
        break;
      }
    }
    if (!found) return { status: 'error', message: 'skip not found' };
  } else {
    savedId = 's' + Date.now() + Math.random().toString(36).slice(2,5);
    sheet.appendRow([savedId, "'" + date, from, to, title, data.notes || '', now]);
  }

  applyTimeSkip(date, from, to, savedId);
  return { status: 'success', id: savedId };
}

/* [93] */ function timeSkipDelete(id) {
  if (!id) return { status: 'error', message: 'no id' };
  const sheet = getTimeSkipsSheet();

  const data = sheet.getDataRange().getValues();
  let skipDate = '', skipFrom = '', skipTo = '';
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(id)) {
      let d = data[i][1];
      if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      skipDate = String(d || '').trim();
      skipFrom = String(data[i][2] || '').trim();
      skipTo   = String(data[i][3] || '').trim();
      sheet.deleteRow(i+1);
      break;
    }
  }

  if (skipDate) removeTimeSkip(skipDate, skipFrom, skipTo);
  return { status: 'success' };
}

/* [94] */ function applyTimeSkip(dateDMY, fromDot, toDot, skipId) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('CALENDAR_ITEMS');
  if (!sheet) return;

  const targetDMY = dateToDMY(dateDMY);
  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  const data = sheet.getDataRange().getValues();
  let touched = 0;

  for (let i = 1; i < data.length; i++) {
    const id = String(data[i][0] || '');
    if (!id) continue;
    if (id.indexOf('cdrem_') === 0) continue;

    const type = String(data[i][1] || '').trim();
    if (type !== 'reminder') continue;

    let d = data[i][2];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const itemDate = String(d || '').trim();
    if (itemDate !== targetDMY) continue;

    const itemMin = hhmmToMin(data[i][3]);
    if (itemMin === null) continue;
    if (itemMin < fromMin || itemMin >= toMin) continue;

    sheet.getRange(i+1, 10).setValue('skipped');

    const eventId = String(data[i][11] || '').trim();
    if (eventId) {
      try {
        const cals = CalendarApp.getCalendarsByName('LifeOS');
        for (let c = 0; c < cals.length; c++) {
          const ev = cals[c].getEventById(eventId);
          if (ev) {
            ev.removeAllReminders();
            ev.setTitle('[SKIPPED] ' + ev.getTitle().replace(/^\[SKIPPED\]\s*/, ''));
            break;
          }
        }
      } catch (_) {}
    }
    touched++;
  }

  try { silenceRoutineInSkip(dateDMY, fromDot, toDot); } catch (_) {}
  try { markRoutineAsSkipped(dateDMY, fromDot, toDot, 'Time skip'); } catch (_) {}
  return touched;
}

/* [95] */ function removeTimeSkip(dateDMY, fromDot, toDot) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('CALENDAR_ITEMS');
  if (!sheet) return;

  const targetDMY = dateToDMY(dateDMY);
  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  const data = sheet.getDataRange().getValues();
  let restored = 0;

  for (let i = 1; i < data.length; i++) {
    const id = String(data[i][0] || '');
    if (!id) continue;
    if (id.indexOf('cdrem_') === 0) continue;

    const type = String(data[i][1] || '').trim();
    if (type !== 'reminder') continue;
    if (String(data[i][9] || '').trim() !== 'skipped') continue;

    let d = data[i][2];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const itemDate = String(d || '').trim();
    if (itemDate !== targetDMY) continue;

    const itemMin = hhmmToMin(data[i][3]);
    if (itemMin === null) continue;
    if (itemMin < fromMin || itemMin >= toMin) continue;

    sheet.getRange(i+1, 10).setValue('');

    const eventId = String(data[i][11] || '').trim();
    if (eventId) {
      try {
        const cals = CalendarApp.getCalendarsByName('LifeOS');
        for (let c = 0; c < cals.length; c++) {
          const ev = cals[c].getEventById(eventId);
          if (ev) {
            ev.setTitle(ev.getTitle().replace(/^\[SKIPPED\]\s*/, ''));
            const remind = Number(data[i][8]) || 15;
            try { ev.addPopupReminder(remind); } catch (_) {}
            break;
          }
        }
      } catch (_) {}
    }
    restored++;
  }

  try { unsilenceRoutineInSkip(dateDMY, fromDot, toDot); } catch (_) {}
  try { unmarkRoutineAsSkipped(dateDMY, fromDot, toDot); } catch (_) {}
  return restored;
}

/* [96] */ function silenceRoutineInSkip(dateDMY, fromDot, toDot) {
  const cal = getOrCreateRoutineCalendar();
  const parsed = parseDMY(dateDMY);
  if (!parsed) return 0;

  const y = parsed[0], m = parsed[1], d = parsed[2];
  const dayStart = new Date(y, m, d, 0, 0, 0);
  const dayEnd   = new Date(y, m, d, 23, 59, 59);
  const evs = cal.getEvents(dayStart, dayEnd);

  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  let touched = 0;
  evs.forEach(function (ev) {
    const st = ev.getStartTime();
    const evMin = st.getHours() * 60 + st.getMinutes();
    if (evMin < fromMin || evMin >= toMin) return;

    try { ev.removeAllReminders(); } catch (_) {}
    const t = ev.getTitle();
    if (t.indexOf('[SKIP] ') !== 0) {
      try { ev.setTitle('[SKIP] ' + t); } catch (_) {}
    }
    touched++;
  });
  return touched;
}

/* [97] */ function unsilenceRoutineInSkip(dateDMY, fromDot, toDot) {
  const cal = getOrCreateRoutineCalendar();
  const parsed = parseDMY(dateDMY);
  if (!parsed) return 0;

  const y = parsed[0], m = parsed[1], d = parsed[2];
  const dayStart = new Date(y, m, d, 0, 0, 0);
  const dayEnd   = new Date(y, m, d, 23, 59, 59);
  const evs = cal.getEvents(dayStart, dayEnd);

  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  let restored = 0;
  evs.forEach(function (ev) {
    const st = ev.getStartTime();
    const evMin = st.getHours() * 60 + st.getMinutes();
    if (evMin < fromMin || evMin >= toMin) return;

    const t = ev.getTitle();
    if (t.indexOf('[SKIP] ') !== 0) return;

    try { ev.setTitle(t.replace(/^\[SKIP\]\s*/, '')); } catch (_) {}
    try { ev.removeAllReminders(); } catch (_) {}
    try { ev.addPopupReminder(ROUTINE_LEAD_MIN); } catch (_) {}
    restored++;
  });
  return restored;
}

/* [98] */ function markRoutineAsSkipped(dateDMY, fromDot, toDot, reason) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return 0;

  const targetDMY = dateToDMY(dateDMY);
  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  const all = sheet.getDataRange().getValues();
  if (!all.length) return 0;

  let dateCol = -1;
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === targetDMY) { dateCol = c; break; }
  }

  if (dateCol === -1) {
    sheet.insertColumnAfter(5);
    dateCol = 5;
    const hdrCell = sheet.getRange(1, dateCol + 1);
    hdrCell.setValue(targetDMY);
    hdrCell.setNumberFormat('@');
    hdrCell.setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  }

  const tasks = getTasksForDate(dateDMY);
  const byArea = {};
  tasks.forEach(function (t) {
    byArea[String(t.area).trim()] = parseStartMinForSkip(t.plannedTime);
  });

  let touched = 0;
  for (let r = 1; r < all.length; r++) {
    const area = String(all[r][2] || '').trim();
    const type = String(all[r][3] || '').trim();
    if (!area) continue;

    const startMin = byArea[area];
    if (startMin === undefined) continue;
    if (startMin < fromMin || startMin >= toMin) continue;

    if (type === 'STATUS') {
      const cell = sheet.getRange(r+1, dateCol+1);
      cell.setValue('NO');
      cell.setBackground('#f87171').setFontColor('#0f172a').setFontWeight('bold');
      touched++;
    } else if (type === 'REASON') {
      sheet.getRange(r+1, dateCol+1).setValue(reason || 'Time skip');
    }
  }
  return touched;
}

/* [99] */ function unmarkRoutineAsSkipped(dateDMY, fromDot, toDot) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return 0;

  const targetDMY = dateToDMY(dateDMY);
  const fromMin = hhmmToMin(fromDot);
  const toMin   = hhmmToMin(toDot);

  const all = sheet.getDataRange().getValues();
  if (!all.length) return 0;

  let dateCol = -1;
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(hv).trim() === targetDMY) { dateCol = c; break; }
  }
  if (dateCol === -1) return 0;

  const tasks = getTasksForDate(dateDMY);
  const byArea = {};
  tasks.forEach(function (t) {
    byArea[String(t.area).trim()] = parseStartMinForSkip(t.plannedTime);
  });

  let restored = 0;
  for (let r = 1; r < all.length; r++) {
    const area = String(all[r][2] || '').trim();
    const type = String(all[r][3] || '').trim();
    if (!area) continue;

    const startMin = byArea[area];
    if (startMin === undefined) continue;
    if (startMin < fromMin || startMin >= toMin) continue;

    if (type === 'STATUS') {
      const cell = sheet.getRange(r+1, dateCol+1);
      if (String(cell.getValue()).trim().toUpperCase() === 'NO') {
        cell.setValue('YES');
        cell.setBackground('#4ade80').setFontColor('#0f172a').setFontWeight('bold');
        restored++;
      }
    } else if (type === 'REASON') {
      sheet.getRange(r+1, dateCol+1).setValue('');
    }
  }
  return restored;
}

/* [100] */ function isInSkipWindow(dateDMY, timeStr) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('TIME_SKIPS');
  if (!sheet) return false;

  const targetDMY = dateToDMY(dateDMY);
  const itemMin = hhmmToMin(timeStr);
  if (itemMin === null) return false;

  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    let d = data[i][1];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    if (String(d).trim() !== targetDMY) continue;

    const fromMin = hhmmToMin(data[i][2]);
    const toMin   = hhmmToMin(data[i][3]);
    if (fromMin === null || toMin === null) continue;
    if (itemMin >= fromMin && itemMin < toMin) return true;
  }
  return false;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION S — DASHBOARD
   ═══════════════════════════════════════════════════════════════ */

/* [101] */ function getDashboardData(period, dateDMY) {
  period = period || 'today';
  const cache = CacheService.getScriptCache();
  const key = 'dash_v2_' + period + '_' + dateDMY;

  const hit = cache.get(key);
  if (hit) return JSON.parse(hit);

  const result = _getDashboardDataUncached(period, dateDMY);

  if (result && result.status === 'success') {
    try {
      const s = JSON.stringify(result);
      if (s.length < 100000) cache.put(key, s, 300);
    } catch (e) {
      Logger.log('[dashboard] cache put failed: ' + e);
    }
  }
  return result;
}

/* [102] */ function _getDashboardDataUncached(period, dateDMY) {
  const parts = parseDMY(dateDMY);
  if (!parts) return { status: 'error', message: 'bad date' };
  const base = new Date(parts[0], parts[1], parts[2]);

  let startDate, endDate;
  if (period === 'today') {
    startDate = new Date(base); endDate = new Date(base);
  } else if (period === 'week') {
    const day = base.getDay();
    startDate = new Date(base);
    startDate.setDate(base.getDate() - day);
    endDate = new Date(startDate);
    endDate.setDate(startDate.getDate() + 6);
  } else if (period === 'month') {
    startDate = new Date(base.getFullYear(), base.getMonth(), 1);
    endDate   = new Date(base.getFullYear(), base.getMonth() + 1, 0);
  } else {
    return { status: 'error', message: 'bad period' };
  }

  const tz = Session.getScriptTimeZone();
  const days = [];
  const d = new Date(startDate);
  while (d <= endDate) {
    days.push(Utilities.formatDate(d, tz, 'dd-MMM-yyyy'));
    d.setDate(d.getDate() + 1);
  }

  const trackerData   = readTrackerGrid(days);
  const healthData    = readHealthGrid(days);
  const nutritionData = readNutritionGrid(days);

  const dailyStats = days.map(function (dmy) { return computeDayStatsFromGrid(dmy, trackerData); });

  const totals = {
    daysWithData: dailyStats.filter(x => x.total > 0).length,
    totalTasks: dailyStats.reduce((s, x) => s + x.total, 0),
    totalYes:   dailyStats.reduce((s, x) => s + x.yes, 0),
    totalNo:    dailyStats.reduce((s, x) => s + x.no, 0),
    totalPartial: dailyStats.reduce((s, x) => s + x.partial, 0)
  };
  totals.avgCompletion = totals.totalTasks > 0
    ? Math.round(totals.totalYes / totals.totalTasks * 100) : 0;

  const byHead = {};
  dailyStats.forEach(function (day) {
    Object.keys(day.heads || {}).forEach(function (h) {
      if (!byHead[h]) byHead[h] = { yes:0, no:0, partial:0, total:0 };
      byHead[h].yes     += day.heads[h].yes;
      byHead[h].no      += day.heads[h].no;
      byHead[h].partial += day.heads[h].partial;
      byHead[h].total   += day.heads[h].yes + day.heads[h].no + day.heads[h].partial;
    });
  });
  Object.keys(byHead).forEach(function (h) {
    const v = byHead[h];
    v.pct = v.total > 0 ? Math.round(v.yes / v.total * 100) : 0;
  });

  let wSum=0,bSum=0,hSum=0,fSum=0,tSum=0, hDays=0;
  const hit = { water:0, 'break':0, hair:0, face:0, teeth:0 };
  days.forEach(function (dmy) {
    const h = healthData[dmy];
    if (!h) return;
    wSum += h.water; bSum += h['break']; hSum += h.hair; fSum += h.face; tSum += h.teeth;
    hDays++;
    if (h.water   >= 12) hit.water++;
    if (h['break']>= 15) hit['break']++;
    if (h.hair    >= 2)  hit.hair++;
    if (h.face    >= 2)  hit.face++;
    if (h.teeth   >= 2)  hit.teeth++;
  });
  const health = hDays ? {
    water: Math.round(wSum/hDays*10)/10,
    'break': Math.round(bSum/hDays*10)/10,
    hair:  Math.round(hSum/hDays*10)/10,
    face:  Math.round(fSum/hDays*10)/10,
    teeth: Math.round(tSum/hDays*10)/10,
    hitDays: hit
  } : { water:0,'break':0,hair:0,face:0,teeth:0,hitDays:hit };

  let foodSum=0,burnSum=0,defSum=0,nDays=0;
  days.forEach(function (dmy) {
    const n = nutritionData[dmy];
    if (!n) return;
    foodSum += n.food; burnSum += n.burn; defSum += n.deficit;
    nDays++;
  });
  const nutrition = nDays ? {
    foodAvg: Math.round(foodSum/nDays),
    burnAvg: Math.round(burnSum/nDays),
    deficitAvg: Math.round(defSum/nDays)
  } : { foodAvg:0, burnAvg:0, deficitAvg:0 };

  let cur = 0;
  for (let i = dailyStats.length - 1; i >= 0; i--) {
    if (dailyStats[i].total > 0 && dailyStats[i].pct >= 70) cur++;
    else break;
  }

  let best = null, worst = null;
  dailyStats.forEach(function (x) {
    if (x.total === 0) return;
    if (!best  || x.pct > best.pct)  best  = x;
    if (!worst || x.pct < worst.pct) worst = x;
  });

  return {
    status: 'success', period: period,
    start: Utilities.formatDate(startDate, tz, 'dd-MMM-yyyy'),
    end:   Utilities.formatDate(endDate,   tz, 'dd-MMM-yyyy'),
    daily: dailyStats,
    totals: totals,
    byHead: byHead,
    health: health,
    nutrition: nutrition,
    streaks: { completion: cur, best: cur },
    best: best,
    worst: worst
  };
}

/* [103] */ function readTrackerGrid(days) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return { dates: {}, rows: [], raw: [] };
  const all = sheet.getDataRange().getValues();
  if (!all.length) return { dates: {}, rows: [], raw: [] };

  const dateCols = {};
  for (let c = 5; c < all[0].length; c++) {
    let hv = all[0][c];
    if (hv instanceof Date) hv = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const key = String(hv).trim();
    if (days.indexOf(key) !== -1) dateCols[key] = c;
  }

  const rows = [];
  for (let r = 1; r < all.length; r++) {
    if (!all[r][2] || !all[r][3]) continue;
    rows.push({ head: all[r][0], area: String(all[r][2]).trim(), type: all[r][3] });
  }
  return { dates: dateCols, rows: rows, raw: all };
}

/* [104] */ function computeDayStatsFromGrid(dmy, grid) {
  const empty = { date: dmy, yes:0, no:0, partial:0, total:0, pct:0, hasData:false, heads:{} };
  if (!grid.raw || !grid.raw.length) return empty;
  const col = grid.dates[dmy];
  if (col === undefined) return empty;

  const stats = { yes:0, no:0, partial:0, total:0, pct:0, hasData:false, heads:{} };
  for (let r = 0; r < grid.rows.length; r++) {
    const row = grid.rows[r];
    if (row.type !== 'STATUS') continue;
    const val = String(grid.raw[r+1][col] || '').trim().toUpperCase();
    if (val !== 'YES' && val !== 'NO' && val !== 'PARTIAL') continue;

    const h = row.head || 'OTHER';
    if (!stats.heads[h]) stats.heads[h] = { yes:0, no:0, partial:0 };

    if (val === 'YES')     { stats.yes++;     stats.heads[h].yes++;     }
    else if (val === 'NO') { stats.no++;      stats.heads[h].no++;      }
    else if (val === 'PARTIAL') { stats.partial++; stats.heads[h].partial++; }
    stats.hasData = true;
  }
  stats.total = stats.yes + stats.no + stats.partial;
  stats.pct = stats.total > 0 ? Math.round(stats.yes / stats.total * 100) : 0;
  return Object.assign({ date: dmy }, stats);
}

/* [105] */ function readHealthGrid(days) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('HEALTH_HABITS');
  const out = {};
  if (!sheet) return out;
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const key = String(d).trim();
    if (days.indexOf(key) === -1) continue;
    out[key] = {
      water:    Number(data[i][1]) || 0,
      'break':  Number(data[i][2]) || 0,
      hair:     Number(data[i][3]) || 0,
      face:     Number(data[i][4]) || 0,
      teeth:    Number(data[i][5]) || 0,
      cyclingM: Number(data[i][12]) || 0,
      cyclingE: Number(data[i][13]) || 0,
      skipping: Number(data[i][14]) || 0,
      steps:    Number(data[i][15]) || 0
    };
  }
  return out;
}

/* [106] */ function readNutritionGrid(days) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('NUTRITION_SUMMARY');
  const out = {};
  if (!sheet) return out;
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    let d = data[i][0];
    if (d instanceof Date) d = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    const key = String(d).trim();
    if (days.indexOf(key) === -1) continue;
    out[key] = {
      food:    Number(data[i][2]) || 0,
      burn:    Number(data[i][4]) || 0,
      deficit: Number(data[i][5]) || 0
    };
  }
  return out;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION T — ORCHESTRATOR
   ═══════════════════════════════════════════════════════════════ */

/* [106b] Install the auto-clean trigger. Run ONCE from Apps Script
   editor. It calls cleanAllPastEvents() every 15 minutes so past
   events disappear automatically. */
function installPastEventCleaner() {
  // Remove any existing triggers for the same function first
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function (t) {
    if (t.getHandlerFunction() === 'cleanAllPastEvents') {
      ScriptApp.deleteTrigger(t);
    }
  });

  ScriptApp.newTrigger('cleanAllPastEvents')
    .timeBased()
    .everyMinutes(15)
    .create();

  Logger.log('✅ Installed 15-min trigger for cleanAllPastEvents');
}
/* [106c] Install a DAILY trigger for reminderSyncAll — run ONCE from
   the Apps Script editor. Ensures birthday/anniversary slots roll to
   next year automatically, and any stale events get cleaned. */
function installDailyReminderSync() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function (t) {
    if (t.getHandlerFunction() === 'reminderSyncAll') {
      ScriptApp.deleteTrigger(t);
    }
  });

  ScriptApp.newTrigger('reminderSyncAll')
    .timeBased()
    .everyDays(1)
    .atHour(2)
    .create();

  Logger.log('✅ Installed daily 02:00 trigger for reminderSyncAll');
}


/* [107] */ function refreshCalendarNow() {
  const t0 = Date.now();
  Logger.log('══════ REFRESH START ' + new Date() + ' ══════');

  const totals = { routine: null, health: null, routineClean: 0, healthClean: 0 };

  try {
    totals.routine = syncRoutineTwoDays();
    Logger.log('  routine sync: ' + JSON.stringify(totals.routine));
  } catch (e) {
    Logger.log('  ❌ routine sync failed: ' + e);
  }

  try {
    totals.health = syncHealthTwoDays();
    Logger.log('  health sync: ' + JSON.stringify(totals.health));
  } catch (e) {
    Logger.log('  ❌ health sync failed: ' + e);
  }

  try {
    totals.routineClean = cleanPastRoutineEvents();
  } catch (e) {
    Logger.log('  ❌ routine cleanup failed: ' + e);
  }

  try {
    totals.healthClean = cleanPastHealthEvents();
  } catch (e) {
    Logger.log('  ❌ health cleanup failed: ' + e);
  }

  const ms = Date.now() - t0;
  Logger.log('  took ' + ms + ' ms');
  Logger.log('══════ REFRESH DONE ══════');
  return totals;
}

/* ═══════════════════════════════════════════════════════════════
   SECTION U — SORT / MIGRATE HELPERS
   ═══════════════════════════════════════════════════════════════ */

/* [108] */ function sortTrackerDateColumns() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('MASTER TRACKER');
  if (!sheet) return;

  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastCol <= 5) return;

  const headerRow = sheet.getRange(1, 6, 1, lastCol - 5).getValues()[0];
  const dataBlock = lastRow > 1
    ? sheet.getRange(2, 6, lastRow - 1, lastCol - 5).getValues()
    : [];

  const MONTHS = { Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11 };
  const cols = [];

  for (let i = 0; i < headerRow.length; i++) {
    let hv = headerRow[i];
    let dmy = '';
    let dt = null;

    if (hv instanceof Date) {
      dmy = Utilities.formatDate(hv, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
      dt = new Date(hv.getFullYear(), hv.getMonth(), hv.getDate());
    } else {
      const s = String(hv).trim();
      const m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
      if (m) {
        dmy = s;
        dt = new Date(parseInt(m[3],10), MONTHS[m[2]], parseInt(m[1],10));
      }
    }

    if (!dmy || !dt || isNaN(dt.getTime())) continue;
    cols.push({ dmy: dmy, dt: dt, idx: i });
  }

  if (cols.length < 2) return;
  cols.sort(function (a, b) { return b.dt - a.dt; });

  let alreadySorted = true;
  for (let i = 0; i < cols.length; i++) {
    if (cols[i].idx !== i) { alreadySorted = false; break; }
  }
  if (alreadySorted) return;

  const newHeader = cols.map(function (c) { return c.dmy; });
  const newData = dataBlock.map(function (row) {
    return cols.map(function (c) { return row[c.idx]; });
  });

  sheet.getRange(1, 6, 1, headerRow.length).clearContent();
  if (lastRow > 1) sheet.getRange(2, 6, lastRow - 1, headerRow.length).clearContent();

  const hdrRange = sheet.getRange(1, 6, 1, newHeader.length);
  hdrRange.setNumberFormat('@');
  hdrRange.setValues([newHeader]);
  hdrRange.setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');

  if (newData.length) {
    sheet.getRange(2, 6, newData.length, newHeader.length).setValues(newData);
  }
}

/* [109] */ function sortSheetRowsByDateDesc(sheetName, dateColIndex) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) return;

  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 3) return;

  const rows = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
  const MONTHS = { Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11 };

  const tagged = rows.map(function (r, idx) {
    let d = r[dateColIndex];
    let dt = null;
    if (d instanceof Date) dt = d;
    else {
      const s = String(d).trim();
      const m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
      if (m) dt = new Date(parseInt(m[3],10), MONTHS[m[2]], parseInt(m[1],10));
    }
    return { row: r, dt: dt, original: idx };
  });

  const sortable = tagged.filter(function (t) { return t.dt && !isNaN(t.dt.getTime()); });
  if (sortable.length < 2) return;

  let ok = true;
  for (let i = 1; i < sortable.length; i++) {
    if (sortable[i-1].dt < sortable[i].dt) { ok = false; break; }
  }
  if (ok) return;

  sortable.sort(function (a, b) { return b.dt - a.dt; });

  const sortedRows = sortable.map(function (t) { return t.row; });
  let cursor = 0;
  const finalRows = tagged.map(function (t) {
    if (t.dt && !isNaN(t.dt.getTime())) return sortedRows[cursor++];
    return t.row;
  });

  sheet.getRange(2, 1, finalRows.length, lastCol).setValues(finalRows);
}
/* [W01] Load work rows for a given month + year. */
function workPlanLoad(year, month) {
  const sheet = getWorkSheet();
  const data = sheet.getDataRange().getValues();
  const rows = [];

  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun',
                  'Jul','Aug','Sep','Oct','Nov','Dec'];
  const monthStr = MONTHS[month];

  for (let i = 1; i < data.length; i++) {
    const d = data[i][0];
    if (!d) continue;

    let dmy = '';
    if (d instanceof Date) dmy = Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd-MMM-yyyy');
    else dmy = String(d).trim();

    // Accept both "1-Oct-26" (your format) and "01-Oct-2026"
    let m = dmy.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/);
    let day, mon, yr;
    if (m) {
      day = parseInt(m[1], 10);
      mon = m[2];
      yr = parseInt(m[3], 10);
    } else {
      m = dmy.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2})$/);
      if (!m) continue;
      day = parseInt(m[1], 10);
      mon = m[2];
      yr = 2000 + parseInt(m[3], 10);
    }

    if (mon !== monthStr) continue;
    if (yr !== year) continue;

    rows.push({
      rowIdx: i + 1,
      date: dmy,
      day: day,
      dow: String(data[i][1] || '').trim(),
      planned: String(data[i][2] || '').trim(),
      plannedOccRaw: data[i][3],
      actual: String(data[i][4] || '').trim(),
      actualOccRaw: data[i][5],
      additional: String(data[i][6] || '').trim(),
      notes: String(data[i][7] || '').trim(),                  // column H
      skip: String(data[i][8] || '').trim().toUpperCase() === 'YES'   // column I
    });
  }

  return {
    status: 'success',
    year: year,
    month: month,
    rows: rows,
    dropdown: WORK_REPORT_OPTIONS
  };
}

/* [W02] Save actual report + occurrence for a specific row. */
/* [W02] Save actual report + occurrence for a specific row. */
function workActualSave(payload) {
  const rowIdx = Number(payload.rowIdx) || 0;
  const actual = String(payload.actual || '').trim();
  const actualOcc = String(payload.actualOcc || '').trim();
  if (!rowIdx) return { status: 'error', message: 'no rowIdx' };

  const sheet = getWorkSheet();
  sheet.getRange(rowIdx, 5).setValue(actual);      // column E
  sheet.getRange(rowIdx, 6).setValue(actualOcc);   // column F

  return { status: 'success', rowIdx: rowIdx };
}

/* [W03] Add an additional report row for a date.
   Planned cols stay empty; actual text goes to col D. */
/* [W03] Append text to the ADDITIONAL REPORT column (G) of an existing row. */
function workAdditionalAdd(payload) {
  const rowIdx = Number(payload.rowIdx) || 0;
  const text = String(payload.text || '').trim();
  if (!rowIdx) return { status: 'error', message: 'no rowIdx' };

  const sheet = getWorkSheet();
  const current = String(sheet.getRange(rowIdx, 7).getValue() || '').trim();
  const updated = current ? (current + '\n' + text) : text;
  sheet.getRange(rowIdx, 7).setValue(updated);

  return { status: 'success', rowIdx: rowIdx, additional: updated };
}

/* [W04] Update the text of an additional report row. */
/* [W04] Replace the entire ADDITIONAL REPORT text for a row. */
function workAdditionalUpdate(payload) {
  const rowIdx = Number(payload.rowIdx) || 0;
  const text = String(payload.text || '').trim();
  if (!rowIdx) return { status: 'error', message: 'no rowIdx' };

  const sheet = getWorkSheet();
  sheet.getRange(rowIdx, 7).setValue(text);

  return { status: 'success' };
}
/* [W06] Save the NOTES column (H) for a specific row. */
function workNotesSave(payload) {
  const rowIdx = Number(payload.rowIdx) || 0;
  const text = String(payload.text || '').trim();
  if (!rowIdx) return { status: 'error', message: 'no rowIdx' };

  const sheet = getWorkSheet();
  sheet.getRange(rowIdx, 8).setValue(text);   // column H

  return { status: 'success' };
}
/* [W05] Delete an additional report row. */
/* [W05] Clear the ADDITIONAL REPORT column of a row. */
function workAdditionalDelete(payload) {
  const rowIdx = Number(payload.rowIdx) || 0;
  if (!rowIdx) return { status: 'error', message: 'no rowIdx' };

  const sheet = getWorkSheet();
  sheet.getRange(rowIdx, 7).setValue('');

  return { status: 'success' };
}
